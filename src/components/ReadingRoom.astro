---
import EssayArtwork from './EssayArtwork.astro';
const { posts, showFeature = true } = Astro.props;
const feature = posts.find(p=>p.slug==='governance-at-operating-speed') || posts.find(p=>p.slug==='vital-signs') || posts[0];
const displayedPosts = showFeature && feature ? [feature,...posts.filter(p=>p.path!==feature.path)] : posts;
const familiarTopics = ['Water & systems','AI & governance','Life & learning'];
const availableTopics = [...new Set(posts.map(p=>p.topic))];
const topics = ['All essays',...familiarTopics.filter(t=>availableTopics.includes(t)),...availableTopics.filter(t=>!familiarTopics.includes(t)).sort()];
---
<section class="reading-room" id="essays" data-reading-room>
  <div class="room-heading"><div><span class="room-kicker">THE READING ROOM</span><h2>Find your next read.</h2></div><span class="room-count">{posts.length} essays · one shared lens</span></div>
  <div class="room-tools" hidden data-room-tools><div class="topic-filters" role="group" aria-label="Filter essays by topic">{topics.map((topic,i)=><button type="button" data-topic-filter={topic} aria-pressed={i===0}>{topic}</button>)}</div><label class="room-search"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><circle cx="8" cy="8" r="5.5"/><path d="m12 12 5 5"/></svg><input type="search" placeholder="Find an idea…" data-room-search aria-label="Search essays"/></label></div>
  <div class="room-results" hidden data-room-results><span data-room-count aria-live="polite" class="filter-count"></span><button type="button" data-room-reset hidden>Clear filters ↗</button></div>
  <div class="essay-grid">
    {displayedPosts.map(p=><article class:list={['reading-card',{'reading-lead':showFeature&&p.path===feature?.path}]} data-reading-card data-entry-id={p.path} data-topic={p.topic} data-search-text={`${p.title} ${p.summary} ${p.topic} ${p.takeaway}`}>
      <a class="card-art-link" href={p.href} aria-label={`Read ${p.title}`} tabindex="-1"><EssayArtwork variant={p.visual}/><span class="art-corner" aria-hidden="true">↗</span></a>
      <div class="reading-copy"><div class="reading-meta"><span>{p.topic}</span><span>{p.readMin} min read</span>{p.status!=='PUBLISHED'&&<span class="reading-draft">Draft</span>}</div>
      <h3><a href={p.href}>{p.title}</a></h3><p class="reading-summary">{p.summary}</p>
      <div class="reading-value"><span>Take this with you</span><p>{p.takeaway}</p></div>
      <div class="reading-actions"><a href={p.href}>Read the essay <span aria-hidden="true">↗</span></a><a href={`${p.href}#takeaways`}>Go to takeaways <span aria-hidden="true">↓</span></a></div></div>
    </article>)}
  </div>
  <div class="room-empty" hidden={posts.length>0} data-room-empty><h3>{posts.length?'A different lens might help.':'Every connection starts somewhere.'}</h3><p>{posts.length?'No essays match that search. Try another word or clear the filters.':'The next essay is on its way. Join The Systems Lens on Substack while this reading room grows.'}</p>{posts.length===0&&<a href="/#newsletter">Get the next essay ↗</a>}</div>
  <div class="room-more"><button type="button" data-room-more hidden>Show more essays <span aria-hidden="true">↓</span></button></div>
</section>
<script>
 import {selectReadings} from '../lib/reading-selection.js';
 document.querySelectorAll<HTMLElement>('[data-reading-room]').forEach(room=>{
  const cards=[...room.querySelectorAll<HTMLElement>('[data-reading-card]')];
  if(!cards.length)return;
  room.querySelector<HTMLElement>('[data-room-tools]')!.hidden=false;
  room.querySelector<HTMLElement>('[data-room-results]')!.hidden=false;
  const entries=cards.map(card=>({id:card.dataset.entryId!,topic:card.dataset.topic!,searchText:card.dataset.searchText!}));
  const buttons=room.querySelectorAll<HTMLButtonElement>('[data-topic-filter]');
  const search=room.querySelector<HTMLInputElement>('[data-room-search]')!,more=room.querySelector<HTMLButtonElement>('[data-room-more]')!,reset=room.querySelector<HTMLButtonElement>('[data-room-reset]')!;
  let topic='All essays',limit=6;
  function render(){
   const selection=selectReadings(entries,{topic,query:search.value,limit});
   const ids=new Set(selection.ids);
   cards.forEach(card=>card.hidden=!ids.has(card.dataset.entryId!));
   buttons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.topicFilter===topic)));
   const filtered=topic!=='All essays'||search.value.trim()!=='';
   room.classList.toggle('is-filtered',filtered);reset.hidden=!filtered;
   room.querySelector('[data-room-count]')!.textContent=selection.total?`Showing ${selection.ids.length} of ${selection.total} essay${selection.total===1?'':'s'}`:'No matching essays';
   room.querySelector<HTMLElement>('[data-room-empty]')!.hidden=selection.total!==0;
   more.hidden=!selection.hasMore;
  }
  buttons.forEach(button=>button.addEventListener('click',()=>{topic=button.dataset.topicFilter!;limit=6;render();}));
  search.addEventListener('input',()=>{limit=6;render();});
  reset.addEventListener('click',()=>{topic='All essays';search.value='';limit=6;render();search.focus();});
  more.addEventListener('click',()=>{const previous=selectReadings(entries,{topic,query:search.value,limit}).ids.length;limit+=6;render();const newlyVisible=cards.filter(card=>!card.hidden)[previous];newlyVisible?.querySelector<HTMLAnchorElement>('h3 a')?.focus();});
  render();
 });
</script>
<style>
.reading-room{--editorial-blue:#174bc5;margin:0 auto;max-width:1200px;padding:0 40px;scroll-margin-top:124px}:global([data-theme='obsidian']) .reading-room{--editorial-blue:#91b3ff}.room-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-bottom:30px}.room-kicker{font:600 10px/1.5 var(--font-body);color:var(--editorial-blue);letter-spacing:.15em}.room-heading h2{font:400 clamp(30px,3.3vw,43px)/1.08 var(--font-display);letter-spacing:-.025em;margin:15px 0 0}.room-heading h2 em{color:var(--text-dim)}.room-count,.filter-count{font:11px/1.5 var(--font-body);color:var(--text-dim);white-space:nowrap}.room-tools{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:14px 0;margin-bottom:0;gap:14px}.topic-filters{display:flex;flex-wrap:wrap;gap:7px}.topic-filters button{border:1px solid transparent;border-radius:50px;background:transparent;color:var(--text-dim);padding:9px 14px;font:500 12px/1.4 var(--font-body);cursor:pointer}.topic-filters button:hover{color:var(--editorial-blue);background:var(--surface)}.topic-filters button[aria-pressed=true]{color:var(--bg);background:var(--text)}.topic-filters button:focus-visible{outline:2px solid var(--editorial-blue);outline-offset:3px}.essay-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:44px 36px}.reading-card{min-width:0;display:flex;flex-direction:column;border-bottom:1px solid var(--line);padding-bottom:28px}.card-art-link{position:relative;display:block;color:inherit;text-decoration:none;overflow:hidden}.art-corner{position:absolute;right:18px;bottom:16px;font-size:21px;color:var(--editorial-blue);transition:transform .2s}.card-art-link:hover .art-corner{transform:translate(3px,-3px)}.reading-copy{display:flex;flex-direction:column;flex:1}.reading-meta{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin-top:23px;font:500 10px/1.5 var(--font-body);letter-spacing:.035em;color:var(--text-dim)}.reading-meta>span:first-child{color:var(--editorial-blue)}.reading-draft{padding:2px 7px;border:1px solid var(--line);border-radius:3px;font-size:9px;letter-spacing:.08em;text-transform:uppercase}.reading-card h3{font:400 clamp(29px,3vw,37px)/1.1 var(--font-display);letter-spacing:-.025em;margin:12px 0 15px;text-wrap:balance}.reading-card h3 a{color:var(--text);text-decoration:none}.reading-card h3 a:hover{color:var(--editorial-blue)}.reading-summary{font:14px/1.75 var(--font-body);color:var(--text-dim);max-width:53ch;margin:0 0 23px}.reading-value{margin-top:auto;border-left:2px solid var(--editorial-blue);padding-left:15px}.reading-value>span{font:600 9px/1.5 var(--font-body);letter-spacing:.12em;text-transform:uppercase;color:var(--editorial-blue)}.reading-value p{font:400 20px/1.35 var(--font-display);color:var(--text);margin:6px 0 0;max-width:43ch}.reading-actions{display:flex;justify-content:space-between;gap:20px;margin-top:24px}.reading-actions a{font:500 12px/1.5 var(--font-body);color:var(--text);text-decoration:none}.reading-actions a:hover{text-decoration:underline;text-underline-offset:4px}.reading-actions a:last-child{color:var(--text-dim)}.reading-actions span{margin-left:6px}.reading-lead{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:38px;padding-bottom:36px}.reading-lead .card-art-link{min-height:335px}.reading-lead .card-art-link :global(.essay-artwork){height:100%;aspect-ratio:auto;display:flex;align-items:center}.reading-lead .card-art-link :global(svg){height:auto}.reading-lead .reading-meta{margin-top:0}.reading-lead h3{font-size:clamp(32px,3.8vw,46px)}.is-filtered .reading-lead{grid-column:auto;display:flex;gap:0}.is-filtered .reading-lead .card-art-link{min-height:0}.is-filtered .reading-lead .card-art-link :global(.essay-artwork){aspect-ratio:600/290}.is-filtered .reading-lead .reading-meta{margin-top:23px}.is-filtered .reading-lead h3{font-size:clamp(29px,3vw,37px)}.room-empty{font:20px/1.5 var(--font-display);padding:32px 0}
@media(max-width:750px){.reading-room{padding:0 24px}.room-heading{display:block}.room-count{display:block;margin-top:18px}.room-tools{display:flex;padding:12px 0}.topic-filters{gap:4px}.topic-filters button{font-size:11px;padding:9px 10px;min-height:40px}.filter-count{display:block}.essay-grid{grid-template-columns:1fr;gap:32px}.reading-lead{display:flex;gap:0}.reading-lead .card-art-link{min-height:0}.reading-lead .card-art-link :global(.essay-artwork){aspect-ratio:600/290}.reading-lead .reading-meta{margin-top:23px}.reading-card h3,.reading-lead h3{font-size:34px}.reading-summary{font-size:14px}.reading-value p{font-size:21px}.reading-actions a{font-size:12px}.room-heading h2{font-size:30px}.room-count{margin-top:12px}}
@media(prefers-reduced-motion:reduce){.art-corner{transition:none}}
.room-search{display:flex;align-items:center;gap:9px;min-width:170px;flex:1;max-width:240px;margin-left:auto}.room-search svg{width:18px;height:18px;stroke:var(--text-dim);stroke-width:1.2;flex-shrink:0}.room-search input{width:100%;min-width:0;border:0;background:transparent;padding:10px 0;font:12px/1.6 var(--font-body);color:var(--text)}.room-search input:focus-visible{outline:2px solid var(--publication-gold);outline-offset:4px}.room-results{display:flex;justify-content:space-between;align-items:center;gap:15px;margin:16px 0 26px;min-height:20px}.room-results button{border:0;background:transparent;color:var(--text-dim);font:11px/1.7 var(--font-body);cursor:pointer;text-decoration:underline;text-underline-offset:4px}.room-more{display:flex;justify-content:center}.room-more button{border:1px solid var(--line);background:transparent;color:var(--text);padding:14px 25px;margin-top:35px;font:500 12px/1.5 var(--font-body);cursor:pointer}.room-more button span{margin-left:22px}.room-empty{padding:50px 0 70px;text-align:center}.room-empty h3{font:400 32px/1.2 var(--font-display);margin:0 0 16px}.room-empty p{font:14px/1.8 var(--font-body);color:var(--text-dim);max-width:50ch;margin:0 auto 20px}.room-empty a{font:500 12px/1.6 var(--font-body);color:var(--text)}@media(max-width:750px){.room-search{max-width:none;width:100%;margin:0;border-top:1px solid var(--line);padding-top:8px}.room-tools{gap:8px}.room-results{margin:12px 0 24px}}
</style>
