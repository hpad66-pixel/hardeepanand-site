---
import { readingLibrary } from '../lib/reading-library.js';
import { startHere, visualIndex, relatedReadings } from '../lib/discovery.js';
const { posts = readingLibrary(import.meta.env.PROD), showFeature = true } = Astro.props;
const routes = startHere(posts), figures = visualIndex(posts);
const topics = [...new Set(posts.map(p=>p.topic))].sort();
const uid = `room-${crypto.randomUUID()}`;
const modes = [{id:'all',anchor:'essays',label:'All writing'}, {id:'start-here',anchor:'start-here',label:'Start here'}, {id:'visual-index',anchor:'visual-index',label:'Visual index'}];
const searchText = p => `${p.title} ${p.summary||''} ${p.topic} ${p.takeaway}`;
---
<section class="reading-room" id="essays" data-reading-room>
 <header class="room-heading"><div><span class="room-kicker">THE READING ROOM</span><h2>Find your next question.</h2></div><span class="room-count">{posts.length} {posts.length===1?'essay':'essays'}</span></header>
 <nav class="room-modes" aria-label="Ways to explore" data-room-tabs>
  {modes.map(mode=><a id={`${uid}-tab-${mode.id}`} href={`#${mode.anchor}`} data-room-view={mode.id} aria-controls={`${uid}-${mode.id}`}>{mode.label}</a>)}
 </nav>
 <div class="room-tools" hidden data-room-tools>
  <label class="room-search"><span>Search</span><input type="search" placeholder="An idea, question, or title" data-room-search /></label>
  <label class="room-topic"><span>Topic</span><select data-room-topic><option value="">All topics</option>{topics.map(topic=><option value={topic}>{topic}</option>)}</select></label>
  <button type="button" data-room-reset hidden>Clear filters</button>
 </div>
 <div class="room-results" hidden data-room-results><span data-room-count role="status" aria-live="polite" aria-atomic="true"></span></div>
 <div id={`${uid}-all`} data-room-panel="all" aria-labelledby={`${uid}-tab-all`}>
  <div class="essay-list">
   {posts.map((p,i)=>{const related=relatedReadings(posts,p.slug,1);return <article class:list={['reading-entry',{'reading-feature':showFeature&&i===0}]} data-content-path={p.href} data-discovery-entry data-entry-id={`all:${p.path}`} data-view="all" data-topic={p.topic} data-search-text={searchText(p)}>
    <span class="entry-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span>
    <div class="entry-copy"><div class="reading-meta"><span>{p.topic}</span><span>{p.readMin} min read</span>{p.status!=='PUBLISHED'&&<span>Draft</span>}</div><h3><a href={p.href}>{p.title}</a></h3><p class="reading-summary">{p.summary}</p>
     {related.map(({post,reason})=><details class="reading-connection"><summary>Follow the connection</summary><p>{reason}</p><a href={post.href}>{post.title} <span aria-hidden="true">↗</span></a></details>)}
    </div>
    <div class="reading-value"><span>Take this with you</span><p>{p.takeaway}</p><a class="read-link" href={p.href}>Read the essay <span aria-hidden="true">↗</span></a></div>
   </article>})}
  </div>
 </div>
 <div id={`${uid}-start-here`} data-room-panel="start-here" aria-labelledby={`${uid}-tab-start-here`}>
  <h3 class="mode-heading" id="start-here">A question is a good place to begin.</h3>
  <div class="route-list">{routes.map(({id,question,reason,post})=><article class="reader-route" data-content-path={post.href} data-discovery-entry data-entry-id={`start:${id}`} data-view="start-here" data-topic={post.topic} data-search-text={`${question} ${reason} ${searchText(post)}`}>
   <div><span class="reading-meta">{post.topic}{post.status!=='PUBLISHED'?' · Draft':''}</span><h4>{question}</h4></div>
   <div><h5><a href={post.href}>{post.title} <span aria-hidden="true">↗</span></a></h5><p>{reason}</p><p class="route-takeaway">{post.takeaway}</p></div>
  </article>)}</div>
 </div>
 <div id={`${uid}-visual-index`} data-room-panel="visual-index" aria-labelledby={`${uid}-tab-visual-index`}>
  <h3 class="mode-heading" id="visual-index">See the relationship.</h3>
  <div class="visual-grid">{figures.map(figure=><article class="visual-entry" data-content-path={figure.post.href} data-discovery-entry data-entry-id={`visual:${figure.post.path}:${figure.anchor}`} data-view="visual-index" data-topic={figure.post.topic} data-search-text={`${figure.title} ${figure.caption} ${searchText(figure.post)}`}>
   <a class="visual-image" href={figure.href} aria-label={`${figure.title} in ${figure.post.title}`}><picture>{figure.mobileImage&&<source media="(max-width: 600px)" srcset={figure.mobileImage}/>}<img src={figure.image} alt={figure.title} loading="lazy" decoding="async" width="900" height="500" /></picture></a>
   <div class="reading-meta"><span>{figure.post.topic}</span>{figure.post.status!=='PUBLISHED'&&<span>Draft</span>}</div><h4><a href={figure.href}>{figure.title} <span aria-hidden="true">↗</span></a></h4><p>{figure.caption}</p><a class="visual-parent" href={figure.post.href}>{figure.post.title}</a>
  </article>)}</div>
 </div>
 <div class="room-empty" data-room-empty hidden={posts.length>0}><h3 data-empty-title>No essays yet.</h3><p data-empty-copy>The next essay is on its way.</p></div>
 <div class="room-more"><button type="button" data-room-more hidden>Show more <span aria-hidden="true">↓</span></button></div>
</section>
<script>
 import { discoveryView, selectDiscovery, readDiscoveryState, writeDiscoveryState } from '../lib/discovery.js';
 function setupReadingRooms(){
 document.querySelectorAll<HTMLElement>('[data-reading-room]').forEach(room=>{
  if(room.dataset.ready)return;room.dataset.ready='true';
  const cards=[...room.querySelectorAll<HTMLElement>('[data-discovery-entry]')];
  const entries=cards.map(card=>({id:card.dataset.entryId!,view:card.dataset.view!,topic:card.dataset.topic!,searchText:card.dataset.searchText!}));
  const tabs=[...room.querySelectorAll<HTMLAnchorElement>('[data-room-view]')];
  const panels=[...room.querySelectorAll<HTMLElement>('[data-room-panel]')];
  const search=room.querySelector<HTMLInputElement>('[data-room-search]')!;
  const topic=room.querySelector<HTMLSelectElement>('[data-room-topic]')!;
  const reset=room.querySelector<HTMLButtonElement>('[data-room-reset]')!;
  const more=room.querySelector<HTMLButtonElement>('[data-room-more]')!;
  const topics=[...topic.options].map(option=>option.value);
  let view='all',limit=6;
  search.maxLength=300;
  room.querySelector<HTMLElement>('[data-room-tools]')!.hidden=false;
  room.querySelector<HTMLElement>('[data-room-results]')!.hidden=false;
  room.querySelector('[data-room-tabs]')!.setAttribute('role','tablist');
  panels.forEach(panel=>{panel.setAttribute('role','tabpanel');panel.tabIndex=0;});
  function render(){
   const selection=selectDiscovery(entries,{view,topic:topic.value,query:search.value,limit});
   const visible=new Set(selection.ids);
   cards.forEach(card=>card.hidden=!visible.has(card.dataset.entryId!));
   panels.forEach(panel=>panel.hidden=panel.dataset.roomPanel!==view);
   tabs.forEach(tab=>{const active=tab.dataset.roomView===view;tab.setAttribute('role','tab');tab.setAttribute('aria-selected',String(active));tab.tabIndex=active?0:-1;});
   reset.hidden=!(topic.value||search.value.trim());
   const unit=view==='visual-index'?'diagram':view==='start-here'?'reading route':'essay';
   room.querySelector('[data-room-count]')!.textContent=selection.total?`Showing ${selection.ids.length} of ${selection.total} ${unit}${selection.total===1?'':'s'}`:`No matching ${unit}s`;
   room.querySelector<HTMLElement>('[data-room-empty]')!.hidden=selection.total>0;
   room.querySelector('[data-empty-title]')!.textContent=entries.some(entry=>entry.view===view)?'No matches this time.':`No ${unit}s yet.`;
   room.querySelector('[data-empty-copy]')!.textContent=topic.value||search.value.trim()?'Try another word or clear the filters.':'New reading will appear here as the library grows.';
   more.hidden=!selection.hasMore;more.firstChild!.textContent=`Show more ${unit}s `;
  }
  function persist(scroll=false){
   const url=writeDiscoveryState(new URL(location.href),{view,topic:topic.value,query:search.value,limit});
   history.replaceState({...history.state,readingRoom:scroll?{url:url.href,scrollY:window.scrollY}:null},'',url);
  }
  function restore(){
   const state=readDiscoveryState(new URL(location.href),topics,entries.length);
   view=state.view;limit=state.limit;topic.value=state.topic;search.value=state.query;
   render();
   const saved=history.state?.readingRoom;
   if(saved?.url===location.href&&Number.isFinite(saved.scrollY)&&saved.scrollY>=0){
    requestAnimationFrame(()=>window.scrollTo({top:saved.scrollY,behavior:'instant'}));
   }
  }
  function activate(next:string){view=discoveryView(next);limit=6;render();}
  tabs.forEach((tab,index)=>{
   tab.addEventListener('click',event=>{if(event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;event.preventDefault();activate(tab.dataset.roomView!);const url=new URL(location.href);url.hash=view==='all'?'essays':view;history.replaceState({...history.state,readingRoom:null},'',url);persist();});
   tab.addEventListener('keydown',event=>{let target=index;if(event.key==='ArrowRight')target=(index+1)%tabs.length;else if(event.key==='ArrowLeft')target=(index+tabs.length-1)%tabs.length;else if(event.key==='Home')target=0;else if(event.key==='End')target=tabs.length-1;else return;event.preventDefault();tabs[target].focus();tabs[target].click();});
  });
  window.addEventListener('hashchange',restore);
  window.addEventListener('popstate',restore);
  window.addEventListener('pageshow',restore);
  window.addEventListener('pagehide',()=>persist(true));
  room.addEventListener('click',event=>{
   const link=(event.target as Element).closest<HTMLAnchorElement>('a[href]');
   if(link&&!link.hasAttribute('data-room-view'))persist(true);
  },{capture:true});
  search.addEventListener('input',()=>{limit=6;render();persist();});
  topic.addEventListener('change',()=>{limit=6;render();persist();});
  reset.addEventListener('click',()=>{search.value='';topic.value='';limit=6;render();persist();search.focus();});
  more.addEventListener('click',()=>{const previous=selectDiscovery(entries,{view,topic:topic.value,query:search.value,limit}).ids.length;limit+=6;render();persist();cards.filter(card=>!card.hidden)[previous]?.querySelector<HTMLAnchorElement>('a')?.focus();});
  restore();
 });
 }
 setupReadingRooms();
 document.addEventListener('astro:page-load',setupReadingRooms);
</script>
<style>
.reading-room{--room-ink:#152e40;--room-muted:#52616c;--room-blue:#174bc5;--room-line:#d6dde2;--room-control-bg:#fff;--room-diagram-bg:#fafbfc;--room-hover:#f0f5ff;max-width:1200px;margin:0 auto;padding:30px 40px 32px;color:var(--room-ink);background:transparent;scroll-margin-top:100px;font-family:var(--font-body,Inter,sans-serif);letter-spacing:0}.reading-room [hidden]{display:none!important}.room-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:26px}.room-kicker{font-size:10px;font-weight:600;color:var(--room-blue)}.room-heading h2{font:400 38px/1.15 var(--font-display,Newsreader,serif);margin:10px 0 0;letter-spacing:0}.room-count{font-size:12px;color:var(--room-muted);white-space:nowrap}.room-modes{display:flex;gap:24px;border-bottom:1px solid var(--room-line)}.room-modes a{display:flex;align-items:center;min-height:48px;border-bottom:3px solid transparent;font-size:14px;font-weight:600;color:var(--room-muted);text-decoration:none}.room-modes a[aria-selected=true]{border-color:var(--room-blue);color:var(--room-blue)}.room-tools{display:flex;align-items:end;gap:20px;padding:18px 0;border-bottom:1px solid var(--room-line)}.room-tools label{display:flex;flex-direction:column;gap:7px;min-width:0}.room-tools label>span{font-size:11px;font-weight:600}.room-search{flex:1}.room-topic{flex:0 1 220px}.room-tools input,.room-tools select{width:100%;box-sizing:border-box;min-height:44px;border:1px solid var(--room-line);border-radius:0;padding:10px 12px;background:var(--room-control-bg);color:var(--room-ink);font:14px/1.4 var(--font-body,Inter,sans-serif)}.room-tools button,.room-more button{min-height:44px;border:1px solid var(--room-line);border-radius:0;background:var(--room-control-bg);color:var(--room-blue);font:500 13px/1.4 var(--font-body,Inter,sans-serif);padding:10px 16px;cursor:pointer}.room-results{font-size:12px;color:var(--room-muted);padding:16px 0;min-height:18px}.reading-entry{display:grid;grid-template-columns:32px minmax(0,1.4fr) minmax(0,1fr);gap:24px;border-bottom:1px solid var(--room-line);padding:28px 0}.reading-feature{border-top:2px solid #a77b26}.entry-number{font-size:11px;color:var(--room-muted);padding-top:3px;font-variant-numeric:tabular-nums}.entry-copy,.reading-value{min-width:0}.reading-meta{display:flex;gap:14px;flex-wrap:wrap;font-size:11px;line-height:1.5;color:var(--room-muted)}.reading-meta>span:first-child{color:var(--room-blue)}.reading-entry h3{font:400 29px/1.15 var(--font-display,Newsreader,serif);letter-spacing:0;margin:9px 0 12px;overflow-wrap:anywhere}.reading-room a{color:inherit;text-underline-offset:4px}.reading-entry h3 a,.reader-route h5 a,.visual-entry h4 a{text-decoration:none}.reading-room a:hover{color:var(--room-blue);text-decoration:underline}.reading-summary,.reader-route p,.visual-entry p{font-size:14px;line-height:1.65;color:var(--room-muted);margin:0;overflow-wrap:anywhere}.reading-value{border-left:2px solid #ad873e;padding-left:20px}.reading-value>span{font-size:10px;font-weight:600;color:var(--room-muted)}.reading-value p{font:400 22px/1.35 var(--font-display,Newsreader,serif);margin:10px 0 18px;overflow-wrap:anywhere}.reading-value .read-link{font-size:12px;font-weight:600;color:var(--room-blue)}.reading-connection{margin-top:16px;font-size:12px;line-height:1.6}.reading-connection summary{cursor:pointer;color:var(--room-blue);padding:8px 0;min-height:24px}.reading-connection p{margin:2px 0 8px;color:var(--room-muted)}.reading-connection a{display:inline-block;padding:5px 0}.mode-heading{font:400 26px/1.2 var(--font-display,Newsreader,serif);letter-spacing:0;margin:24px 0;scroll-margin-top:110px}.reader-route{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:40px;padding:26px 0;border-bottom:1px solid var(--room-line)}.reader-route h4{font:400 28px/1.2 var(--font-display,Newsreader,serif);letter-spacing:0;margin:8px 0}.reader-route h5{font:600 15px/1.5 var(--font-body,Inter,sans-serif);letter-spacing:0;margin:0 0 8px;color:var(--room-blue)}.reader-route .route-takeaway{margin-top:12px;color:var(--room-ink);border-left:2px solid #ad873e;padding-left:12px}.visual-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32px}.visual-entry{min-width:0;padding-bottom:24px;border-bottom:1px solid var(--room-line)}.visual-image{display:block;aspect-ratio:9/5;margin-bottom:16px;background:var(--room-diagram-bg)}.visual-image picture{display:block;width:100%;height:100%}.visual-image img{display:block;width:100%;height:100%;object-fit:contain}.visual-entry h4{font:400 25px/1.2 var(--font-display,Newsreader,serif);letter-spacing:0;margin:10px 0}.visual-parent{display:inline-block;font-size:12px;line-height:1.5;margin-top:14px}.room-empty{padding:40px 0}.room-empty h3{font:400 28px/1.2 var(--font-display,Newsreader,serif);letter-spacing:0}.room-empty p{font-size:14px;color:var(--room-muted)}.room-more{display:flex;justify-content:center;margin-top:24px}.reading-room :is(a,button,input,select,summary,[role=tabpanel]):focus-visible{outline:2px solid var(--room-blue);outline-offset:4px}.room-tools button:hover,.room-more button:hover{background:var(--room-hover)}.reading-room h4,.reading-room h5{overflow-wrap:anywhere}
:global([data-theme='obsidian']) .reading-room{--room-ink:#edf2f5;--room-muted:#b5c2cc;--room-blue:#91b3ff;--room-line:#40515d;--room-control-bg:#142530;--room-diagram-bg:#142530;--room-hover:#20384b}
@media(max-width:750px){.reading-room{padding:30px 20px 28px}.room-heading h2{font-size:30px}.room-heading{gap:14px}.room-modes{gap:20px}.room-modes a{font-size:13px}.room-tools{flex-wrap:wrap;gap:12px}.room-search{flex-basis:100%}.room-topic{flex:1}.reading-entry{grid-template-columns:24px minmax(0,1fr);gap:12px;padding:24px 0}.reading-entry h3{font-size:27px}.reading-value{grid-column:2;padding-left:14px;margin-top:8px}.reading-value p{font-size:21px}.reader-route{grid-template-columns:1fr;gap:12px}.reader-route h4{font-size:26px}.visual-grid{grid-template-columns:1fr;gap:28px}.visual-image:has(source){aspect-ratio:4/5}.room-count{font-size:11px}}
@media(max-width:360px){.room-modes{gap:14px}.room-modes a{font-size:12px}.room-heading{align-items:start}.room-heading h2{font-size:28px}.room-count{padding-top:4px}}
.reading-room{--room-muted:#415565}
.room-kicker,.room-tools label>span,.reading-value>span{font-size:12px}
.room-count,.room-results,.entry-number,.reading-meta,.visual-parent{font-size:13px}
.room-modes a{font-size:15px;color:var(--room-ink)}
.room-tools input,.room-tools select{font-size:16px}
.room-tools select{height:44px}
.room-tools button,.room-more button{font-size:14px}
.reading-entry{grid-template-columns:32px minmax(0,1.6fr) minmax(0,1fr)}
.reading-entry h3{font-size:32px;line-height:1.18}
.reading-summary,.reader-route p,.visual-entry p{font-size:16px;line-height:1.65}
.reading-value p{font:400 16px/1.65 var(--font-body,Inter,sans-serif);margin:10px 0 18px}
.reading-value .read-link,.reading-connection{font-size:14px}
:global([data-theme='obsidian']) .reading-room{--room-muted:#c5d0d8}
@media(max-width:750px){.reading-entry{grid-template-columns:24px minmax(0,1fr)}.reading-entry h3{font-size:29px}.reading-summary,.reading-value p,.reader-route p,.visual-entry p{font-size:15px}.reading-meta,.room-count{font-size:12px}.room-modes{gap:18px}.room-modes a{font-size:14px}}
@media(max-width:360px){.room-modes{gap:14px}.room-modes a{font-size:13px}.reading-entry h3{font-size:27px}}
@media(max-width:1000px){.reading-value .read-link,.reading-connection a,.visual-parent{display:inline-flex;align-items:center;min-height:44px}.reading-connection summary{min-height:44px;align-content:center}.reader-route h5 a{display:block;min-height:44px;align-content:center}}
</style>
