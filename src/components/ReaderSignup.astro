<section class="reader-invitation" id="newsletter" aria-labelledby="reader-invitation-title" data-reader-signup>
 <div class="reader-invitation-copy"><span class="reader-eyebrow">THE CONVERSATION CONTINUES</span><h2 id="reader-invitation-title">A shared lens.<br/><em>A wider perspective.</em></h2><p>New essays. Practical takeaways. A place to compare notes with people who care about the systems we share.</p><a href="https://www.thesystemslens.com/">Read and discuss on Substack <span aria-hidden="true">↗</span></a></div>
 <div class="reader-invitation-form"><h3>Make room for the next idea.</h3><form action="https://www.thesystemslens.com/subscribe" method="get" data-signup-form>
 <label for="newsletter-email">Your email</label><input id="newsletter-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" required maxlength="254"/>
 <div data-crm-opt-in hidden><label class="reader-permission"><input type="checkbox" data-reader-consent/><span>Also save my details with APAS so we can connect about these ideas. This is separate from my Substack subscription.</span></label><div data-reader-name-wrap hidden><label for="newsletter-name">Your name</label><input id="newsletter-name" type="text" autocomplete="name" maxlength="100" data-reader-name/></div><label class="reader-trap" aria-hidden="true">Website<input type="text" data-reader-trap tabindex="-1" autocomplete="off"/></label></div>
 <button type="submit">Continue to Substack <span aria-hidden="true">↗</span></button><p class="reader-form-status" role="status" data-signup-status></p>
 </form><p class="reader-fine">Confirm your subscription on Substack. Unsubscribe there anytime. <a href="https://www.thesystemslens.com/subscribe">Go directly to Substack</a> or <a href="/rss.xml">read via RSS.</a></p></div>
</section>
<script>
 document.querySelectorAll<HTMLElement>('[data-reader-signup]').forEach(root=>{
 const form=root.querySelector<HTMLFormElement>('[data-signup-form]')!,consent=root.querySelector<HTMLInputElement>('[data-reader-consent]')!,name=root.querySelector<HTMLInputElement>('[data-reader-name]')!,status=root.querySelector<HTMLElement>('[data-signup-status]')!,button=form.querySelector<HTMLButtonElement>('button')!;
 let ready=false,id=crypto.randomUUID(),snapshot='';
 fetch('/api/subscriptions',{headers:{Accept:'application/json'}}).then(r=>r.ok?r.json():null).then(data=>{ready=data?.ready===true;root.querySelector<HTMLElement>('[data-crm-opt-in]')!.hidden=!ready;}).catch(()=>{});
 consent.addEventListener('change',()=>{name.required=consent.checked;root.querySelector<HTMLElement>('[data-reader-name-wrap]')!.hidden=!consent.checked;});
 form.addEventListener('submit',async event=>{
 if(!ready||!consent.checked)return;
 event.preventDefault();button.disabled=true;status.textContent='Saving your details with APAS…';
 const email=root.querySelector<HTMLInputElement>('#newsletter-email')!.value.trim();
 const payload={name:name.value.trim(),email,consent:true,articlePath:'/',website:root.querySelector<HTMLInputElement>('[data-reader-trap]')!.value};
 const current=JSON.stringify(payload);if(snapshot&&snapshot!==current)id=crypto.randomUUID();snapshot=current;
 try{const response=await fetch('/api/subscriptions',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...payload,id})});const data=await response.json();if(!response.ok||!data.accepted)throw new Error(data.error||'Delivery could not be confirmed.');status.textContent='Your details reached APAS. Continue on Substack to confirm your subscription.';const destination=new URL('https://www.thesystemslens.com/subscribe');destination.searchParams.set('email',email);window.location.assign(destination.href);}
 catch(error){status.textContent=`${error instanceof Error?error.message:'Delivery could not be confirmed.'} You can retry, or use the direct Substack link below.`;button.disabled=false;}
 });
 });
</script>
<style>
.reader-invitation{max-width:1120px;margin:45px auto 0;padding:45px 0 30px;border-top:3px double var(--publication-gold);display:grid;grid-template-columns:1.15fr 1fr;gap:90px;scroll-margin-top:130px}.reader-eyebrow{font:600 9px/1.6 var(--font-body);letter-spacing:.15em;color:var(--publication-gold)}.reader-invitation h2{font:400 49px/1.03 var(--font-display);letter-spacing:-.03em;margin:20px 0}.reader-invitation h2 em{color:var(--text-dim)}.reader-invitation-copy p{font:14px/1.8 var(--font-body);color:var(--text-dim);max-width:44ch}.reader-invitation-copy>a{font:500 12px/1.6 var(--font-body);display:inline-block;margin-top:13px;color:var(--text);text-decoration:none}.reader-invitation-copy>a span{margin-left:15px}.reader-invitation-form{padding-top:24px}.reader-invitation h3{font:400 27px/1.2 var(--font-display);margin:0 0 22px}.reader-invitation label{display:block;font:500 11px/1.7 var(--font-body);margin:16px 0 7px}.reader-invitation input[type=email],.reader-invitation input[type=text]{width:100%;min-width:0;padding:13px 14px;border:1px solid var(--line);background:transparent;color:var(--text);font:14px/1.6 var(--font-body);border-radius:0;box-sizing:border-box}.reader-invitation button{width:100%;display:flex;justify-content:space-between;gap:15px;padding:15px 17px;margin-top:16px;border:0;background:var(--text);color:var(--bg);font:500 12px/1.5 var(--font-body);cursor:pointer}.reader-invitation button:disabled{opacity:.65;cursor:wait}.reader-invitation .reader-permission{display:flex;gap:10px;align-items:start;font:11px/1.7 var(--font-body);color:var(--text-dim)}.reader-permission input{margin-top:4px;accent-color:var(--text);flex-shrink:0}.reader-fine,.reader-form-status{font:11px/1.7 var(--font-body);color:var(--text-dim);margin:13px 0 0}.reader-fine a{color:inherit;text-underline-offset:3px}.reader-trap{position:absolute!important;left:-10000px}.reader-invitation :focus-visible{outline:2px solid var(--publication-gold);outline-offset:4px}
@media(max-width:1200px){.reader-invitation{margin-inline:40px;gap:50px}}@media(max-width:650px){.reader-invitation{margin:35px 24px 0;padding-top:30px;grid-template-columns:1fr;gap:15px}.reader-invitation h2{font-size:43px}.reader-invitation-form{padding-top:15px}}
</style>
