---
const { substackUrl } = Astro.props;
// Only pass a verified matching post URL. An unpublished/local essay has no Substack comments thread.
const destination = substackUrl || 'https://www.thesystemslens.com/';
---
<section class="substack-discussion" id="comments" aria-labelledby="discussion-heading">
 <span class="discussion-symbol" aria-hidden="true"><svg viewBox="0 0 40 40" fill="none"><path d="M6 7h28v21H19l-9 6v-6H6V7Z"/><path d="M12 14h16M12 20h10"/></svg></span>
 <div><span class="discussion-kicker">YOUR PERSPECTIVE BELONGS HERE</span><h2 id="discussion-heading">What does this look like in your world?</h2><p>Our ideas get better when we compare notes. The conversation lives on Substack, where readers can sign in and comment on published essays.</p><div class="discussion-actions"><a href={destination}>{substackUrl?'Discuss this essay on Substack':'Explore the conversation on Substack'} <span aria-hidden="true">↗</span></a><a href="/#newsletter">Subscribe to the next essay →</a></div></div>
</section>
<style>
.substack-discussion{display:flex;gap:25px;border-block:1px solid var(--line);padding:35px 0;margin:50px 0 25px;scroll-margin-top:125px}.discussion-symbol{flex:0 0 42px;color:var(--publication-gold)}.discussion-symbol svg{width:42px;stroke:currentColor;stroke-width:1.3}.discussion-kicker{font:600 9px/1.5 var(--font-body);letter-spacing:.12em;color:var(--publication-gold)}.substack-discussion h2{font:400 33px/1.1 var(--font-display);margin:12px 0}.substack-discussion p{font:14px/1.8 var(--font-body);color:var(--text-dim);max-width:58ch}.discussion-actions{display:flex;gap:20px;flex-wrap:wrap;margin-top:20px}.discussion-actions a{font:500 12px/1.6 var(--font-body);color:var(--text);text-underline-offset:5px}.discussion-actions a:last-child{color:var(--text-dim)}@media(max-width:600px){.substack-discussion{gap:14px}.discussion-symbol{flex-basis:28px}.discussion-symbol svg{width:28px}.substack-discussion h2{font-size:29px}.discussion-actions{gap:15px}}
</style>
