  .objective{font-size:16px;line-height:1.5;font-weight:500}.objective>span{font-size:11px;display:block;color:var(--dash-accent);font-weight:600;margin-bottom:5px}.key-result{margin-top:21px}.key-result>div>span{display:block;font-size:11px;color:var(--text-dim)}.key-result strong{display:block;font-size:18px;font-weight:500;margin:6px 0}.key-result strong span{font-size:12px;color:var(--text-dim);margin-left:8px}.progress-track{height:6px;background:var(--line);border-radius:5px;overflow:hidden}.progress-track span{display:block;height:100%;background:var(--dash-accent)}.key-result p{font-size:11px;line-height:1.6;color:var(--text-dim)}.package-budget{margin-top:23px;padding-top:16px;border-top:1px solid var(--line)}.package-budget>span{font-size:12px;font-weight:600}.package-budget dl{display:flex;justify-content:space-between;gap:10px;margin:13px 0}.package-budget dt{font-size:11px;color:var(--text-dim);margin-bottom:6px}.package-budget dd{font-size:14px;font-weight:600}.package-budget p{font-size:11px;color:var(--text-dim)}
  .handoff-panel{padding:28px 0}.handoff-heading{display:flex;justify-content:space-between;align-items:center;gap:20px}.chain-label{font-size:11px;color:var(--dash-accent);white-space:nowrap}.accountability-chain{display:grid;grid-template-columns:repeat(4,1fr);list-style:none;padding:0;gap:16px;margin:8px 0 26px}.gate{position:relative;border-top:2px solid var(--line);padding:18px 8px 0 0}.gate-complete{border-color:var(--dash-accent)}.gate-current{border-top-style:dashed;border-color:var(--dash-accent)}.gate-number{font-size:14px;font-weight:600;display:block;color:var(--dash-accent);margin-bottom:12px}.gate-status{font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:var(--text-dim)}.gate h4{font-size:13px;font-weight:600;line-height:1.4;margin:6px 0}.gate p{font-size:11px;line-height:1.6;color:var(--text-dim)}.gate small{display:block;font-size:11px;line-height:1.6;margin-top:10px}.decision-callout{display:flex;gap:16px;border:1px solid var(--dash-accent);border-radius:8px;padding:21px 22px}.decision-arrow{font-size:30px;color:var(--dash-accent);line-height:1}.decision-callout h4{font:400 25px/1.15 Newsreader,serif;margin:7px 0 10px}.decision-callout p{font-size:12px;line-height:1.6;color:var(--text-dim)}.decision-callout strong{font-weight:600}.evidence-note{font-size:12px;line-height:1.8;margin-top:14px;color:var(--text-dim)}
  .next-measures{padding:28px 0;border-top:1px solid var(--line)}.next-measures h3{font:400 28px/1.2 var(--font-display);margin:9px 0 12px}.next-measures>p{font-size:12px;color:var(--text-dim);line-height:1.7}.next-measures dl{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:22px}.next-measures dt{font-size:12px;font-weight:600;color:var(--dash-accent);margin-bottom:10px}.next-measures dd{font-size:13px;line-height:1.7}.next-measures dd span{display:block;font-size:11px;color:var(--text-dim);line-height:1.8;margin-top:10px}
  .benefit-panel{border-block:1px solid var(--line);padding:30px 0;display:grid;grid-template-columns:1.3fr 1fr;gap:24px 40px}.benefit-panel h3{margin-bottom:12px}.benefit-panel h3 em{color:var(--dash-accent)}.benefit-panel>div>p{font-size:12px;line-height:1.8;color:var(--text-dim)}.benefit-panel label{display:block;font-size:11px;font-weight:600;margin:18px 0 8px}.benefit-panel select{background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:5px;padding:11px;width:100%;font-size:12px}.roi-card{border-left:1px solid var(--line);padding:8px 0 8px 32px}.roi-card>strong{display:block;font-size:64px;letter-spacing:-.06em;line-height:1.3;font-weight:400;color:var(--dash-accent)}.roi-card>p{font-variant-numeric:tabular-nums}.roi-status{font-size:11px;display:block;margin-top:14px;font-style:italic;color:var(--text-dim)}.model-note{grid-column:1/-1;font-size:11px;color:var(--text-dim);line-height:1.7;max-width:780px}
  .dashboard-glossary{padding:22px 0}.dashboard-glossary summary{font-size:12px;font-weight:600;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:20px}.dashboard-glossary summary::-webkit-details-marker{display:none}.dashboard-glossary summary span{font-size:21px;color:var(--dash-accent)}.dashboard-glossary[open] summary span{transform:rotate(45deg)}.dashboard-glossary dl{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:24px}.dashboard-glossary dt{font-size:12px;font-weight:600;color:var(--dash-accent);margin-bottom:6px}.dashboard-glossary dd{font-size:11px;line-height:1.8;color:var(--text-dim)}.dashboard-glossary dl>div{scroll-margin-top:30px}.dashboard-footer{display:flex;justify-content:space-between;padding:17px 0;border-top:1px solid var(--line);font-size:11px;color:var(--text-dim)}.dashboard-footer b{color:var(--dash-accent);padding:0 5px}.dashboard-footer a{color:var(--dash-accent);text-decoration:none}.term-link{color:var(--dash-accent);text-decoration:underline;text-decoration-style:dotted;text-underline-offset:3px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
