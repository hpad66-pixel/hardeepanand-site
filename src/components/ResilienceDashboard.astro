  @media(max-width:1000px){.resilience-dashboard{width:100%;margin:48px 0}.dashboard-toolbar{align-items:flex-start;flex-direction:column}.portfolio-metrics{gap:14px}.portfolio-metrics strong{font-size:36px}.accountability-chain{grid-template-columns:repeat(2,1fr);gap:24px}.dashboard-glossary dl{grid-template-columns:repeat(2,1fr)}}
