  .view-label{display:flex;justify-content:space-between;gap:12px;font:600 12px/1.6 Inter,sans-serif;padding-top:23px}.view-label span{font-weight:400;color:var(--text-dim)}.expanded-view{border-top:1px solid var(--line);padding-bottom:18px}.expanded-view .view-label{color:var(--dash-accent)}.expanded-view>p:last-child{font-size:12px;line-height:1.7;color:var(--text-dim);margin-top:8px}.decision-callout{margin-bottom:26px}.spotlight-result{margin-top:9px}.portfolio-metrics{display:grid;grid-template-columns:repeat(3,1fr);padding:28px 0 14px;gap:24px}.portfolio-metrics>div{border-right:1px solid var(--line)}.portfolio-metrics>div:last-child{border:0}.metric-label{display:block;color:var(--text-dim);letter-spacing:.05em}.portfolio-metrics strong{font-size:42px;line-height:1.4;font-weight:500;letter-spacing:-.05em;display:block;font-variant-numeric:tabular-nums}.portfolio-metrics strong small{font-size:22px;font-weight:400;color:var(--text-dim)}.portfolio-metrics div>span:last-child{font-size:12px;color:var(--text-dim)}.budget-note{font-size:11px;line-height:1.6;color:var(--text-dim);padding-bottom:25px}
