---
import { snapshots, money, benefitCase } from '../lib/resilience-dashboard.js';
const gates = ['Understand the exposure', 'Authorize the resources', 'Implement safely', 'Verify with operations'];
const roles = ['IT / security + controls', 'Sponsor + finance + operations', 'Controls lead + vendor', 'Operations + independent checker'];
const forecast = benefitCase(50000);
---
<section class="resilience-dashboard" id="resilience-dashboard" aria-labelledby="dashboard-title" data-resilience-dashboard>
  <header class="dashboard-head">
    <p class="figure-number">02 / The decision room</p>
    <h2 id="dashboard-title">Keep the dashboard.<br /><em>Expand what we can see.</em></h2>
    <p class="dashboard-deck">The familiar project view, enriched with the conditions our teams need to act on.</p>
    <p class="sample-label"><span aria-hidden="true">◇</span> Interactive mock dashboard · All numbers are fictional</p>
  </header>
  <div class="dashboard-toolbar">
    <div><span class="eyebrow">Service in focus</span><h3>Wastewater pumping continuity</h3></div>
    <fieldset class="snapshot-controls"><legend>Explore three example snapshots</legend>{snapshots.map((s, i) => <button type="button" data-snapshot={s.id} aria-pressed={i === 0} aria-controls={`snapshot-${s.id}`}><span class="wide-label">{s.label}</span><span class="short-label">{s.short}</span></button>)}</fieldset>
  </div>
  <p class="snapshot-announcement sr-only" aria-live="polite" aria-atomic="true"></p>
  {snapshots.map((s, i) => <div class="snapshot-panel" id={`snapshot-${s.id}`} hidden={i !== 0}>
    <p class="view-label">The familiar view <span>Projects · budgets · delivery</span></p>
    <div class="portfolio-metrics">
      <div><span class="metric-label">Portfolio delivery · <a class="term-link" href="#term-kpi">KPI</a></span><strong>{s.verified}<small> / 8</small></strong><span>projects verified complete</span></div>
      <div><span class="metric-label">Approved portfolio budget</span><strong>$1.2<small>m</small></strong><span>across all eight projects</span></div>
      <div><span class="metric-label">Portfolio spend to date</span><strong>${s.spent / 1000}<small>k</small></strong><span>{money(1200000 - s.spent)} budget less spend*</span></div>
    </div>
    <p class="budget-note">*Budget less spend is not necessarily cash available: commitments must also be checked.</p>
    <div class="expanded-view"><p class="view-label">The shared resilience view <span>Exposure · evidence · support</span></p><p>These measures help us see where the team needs a decision, resources, or a shared check.</p></div>
    <div class="decision-callout"><span class="decision-arrow" aria-hidden="true">↗</span><div><span class="eyebrow">{s.id === 'verified' ? 'Progress we can build on' : 'Here is the connection we can strengthen'}</span><h4>{s.action}</h4><p><strong>People to bring together:</strong> {s.owner}.</p><p class="spotlight-result">{s.id === 'verified' ? 'One more service has demonstrated recovery. The remaining gaps stay visible for the next team decision.' : s.id === 'funded' ? 'Resources are agreed. Five access paths still await a verified change; controls, the vendor, and operations can now coordinate the work.' : 'Five access paths remain unresolved. Funding and a safe work window help the team move toward a verified result.'}</p></div></div>
    <div class="decision-grid">
      <section class="exposure-panel" aria-labelledby={`exposure-${s.id}`}>
        <span class="eyebrow">01 / What could interrupt service?</span>
        <h3 id={`exposure-${s.id}`}>See where support matters.</h3>
        <dl class="risk-metrics">
          <div><dt>Applicable CVE findings <a href="#term-cve" aria-label="What is a CVE?">?</a><small>Unresolved findings on in-scope assets</small></dt><dd>{s.cves}</dd></div>
          <div><dt>Unresolved access paths<small>Connections still requiring a decision or fix</small></dt><dd>{s.paths}</dd></div>
          <div><dt>Recovery demonstrated<small>Critical services with a current witnessed test</small></dt><dd>{s.recovery}<span> / 6</span></dd></div>
          <div><dt>Overdue decisions<small>Including temporary exceptions past review</small></dt><dd>{s.overdue}</dd></div>
        </dl>
        <p class="metric-footnote">An incomplete inventory can hide additional exposure. These counts cover the six services in scope, not the whole utility.</p>
      </section>
      <section class="outcome-panel" aria-labelledby={`outcome-${s.id}`}>
        <span class="eyebrow">02 / What are we trying to change?</span>
        <h3 id={`outcome-${s.id}`}>Connect resources to outcomes.</h3>
        <p class="objective"><span>Objective · this illustrative quarter · <a class="term-link" href="#term-okr">OKR</a></span>Keep wastewater pumping recoverable when remote access fails.</p>
        <div class="key-result"><div><span>Key result · recovery demonstrated</span><strong>{s.recovery} of 6 <span>→ target 6 of 6</span></strong></div><div class="progress-track" role="img" aria-label={`${s.recovery} of six services demonstrated recovery; target six`}><span style={`width:${s.recovery / 6 * 100}%`}></span></div></div>
        <div class="key-result"><div><span>Key result · unresolved access paths</span><strong>{s.paths} <span>→ target 0</span></strong></div><p>Baseline: 5 identified paths. New discoveries join the register; they do not disappear to protect the target.</p></div>
        <div class="package-budget"><span>Remote-access & recovery work package</span><dl><div><dt>Proposed cost</dt><dd>$120,000</dd></div><div><dt>Allocated</dt><dd>{money(s.allocated)}</dd></div><div><dt>Spent</dt><dd>{money(s.packageSpent)}</dd></div></dl><p>Included within the portfolio figures above.</p></div>
      </section>
    </div>
    <section class="handoff-panel" aria-labelledby={`handoff-${s.id}`}>
      <div class="handoff-heading"><div><span class="eyebrow">03 / Who moves it forward?</span><h3 id={`handoff-${s.id}`}>Share responsibility. Return the evidence.</h3></div><span class="chain-label">Authority ↓ &nbsp; Evidence ↑</span></div>
      <ol class="accountability-chain">{gates.map((gate, index) => <li class={`gate gate-${s.gates[index]}`}><span class="gate-number" aria-hidden="true">{s.gates[index] === 'complete' ? '✓' : `0${index + 1}`}</span><span class="gate-status">{s.gates[index] === 'complete' ? 'Evidence recorded' : s.gates[index] === 'current' ? 'Next handoff' : 'Still required'}</span><h4>{gate}</h4><p>{roles[index]}</p><small>{s.checks[index]}</small></li>)}</ol>

      <p class="evidence-note">{s.evidence}</p>
    </section>
  </div>)}
  <section class="next-measures" aria-labelledby="next-measures-title">
    <span class="eyebrow">More of the operating picture</span><h3 id="next-measures-title">What else should we bring into view?</h3><p>Suggested additions for our own dashboards. Agree the scope, baseline, and owner together.</p>
    <dl><div><dt>Data governance & lineage</dt><dd>How many critical measures can we trace to a checked source?<span>Show: verified measures / measures in scope.<br/>Work together: data steward + service owner.</span></dd></div><div><dt>AI governance</dt><dd>Which AI workflows have reviewed permissions and a responsible human?<span>Show: reviewed workflows / workflows in use.<br/>Work together: process owner + IT/security.</span></dd></div><div><dt>Team capability</dt><dd>Which critical handoffs have our teams practiced together?<span>Show: rehearsed handoffs / handoffs in scope.<br/>Work together: operations + learning lead.</span></dd></div></dl>
  </section>
  <section class="benefit-panel" aria-labelledby="benefit-title">
    <div><span class="eyebrow">04 / What does the investment return?</span><h3 id="benefit-title">Test the benefit case.<br /><em>Keep the assumptions visible.</em></h3><p>A separate illustrative business case: assume $120,000 in total costs over three years. Change the annual operating savings to see how much the return depends on the assumption.</p><label for="savings-assumption">Assumed annual operating savings</label><select id="savings-assumption"><option value="30000">$30,000 / year · cautious case</option><option value="50000" selected>$50,000 / year · middle case</option><option value="70000">$70,000 / year · higher case</option></select></div>
    <div class="roi-card" aria-live="polite" aria-atomic="true"><span class="metric-label">Modeled three-year simple <a class="term-link" href="#term-roi">ROI</a></span><strong data-roi>{forecast.roi}%</strong><p><span data-benefit>{money(forecast.benefit)}</span> assumed savings<br />− $120,000 assumed total cost<br />= <b data-net>{money(forecast.net)}</b> net benefit</p><span class="roi-status">Scenario, not a measured return</span></div>
    <p class="model-note">Simple ROI = (three-year savings − total cost) ÷ total cost. No discounting, financing, or avoided-incident valuation. Finance must validate the costs and savings, including recurring costs; operations must separately verify recovery. A positive modeled ROI does not prove resilience.</p>
  </section>
  <details class="dashboard-glossary" open>
    <summary>Read the dashboard in plain English <span aria-hidden="true">＋</span></summary>
    <dl>
      <div id="term-cve"><dt>CVE · the reference number</dt><dd>A public identifier for a known vulnerability. Count the findings that apply to your assets; a global disclosure count is not your local risk score.</dd></div>
      <div id="term-kpi"><dt>KPI · the condition you track</dt><dd>A key performance indicator: an ongoing measure, such as open access paths or verified projects. Always show its scope and denominator.</dd></div>
      <div id="term-okr"><dt>OKR · the change you intend</dt><dd>An objective and key results: the outcome you want, paired with measurable targets and a date. Connect the work to a service, not only a project milestone.</dd></div>
      <div id="term-roi"><dt>ROI · the financial comparison</dt><dd>Return on investment compares benefits with costs. A forecast depends on assumptions; actual results require evidence after the work.</dd></div>
      <div><dt>Provenance · where it came from</dt><dd>The original advisory, observation, asset record, or test result supporting a decision. Keep its source and date attached.</dd></div>
      <div><dt>Lineage · how it reached this number</dt><dd>The path from source evidence through checks and calculations to the reported metric. Let a reviewer follow it back.</dd></div>
    </dl>
  </details>
  <footer class="dashboard-footer"><span>The Systems Lens <b>·</b> Hardeep Anand</span><a href="https://apas.ai/">APAS Consulting ↗</a></footer>
</section>
<script>
  import { benefitCase, money } from '../lib/resilience-dashboard.js';
  document.querySelectorAll<HTMLElement>('[data-resilience-dashboard]').forEach((dashboard) => {
    dashboard.querySelectorAll('a[href^="#term-"]').forEach((link) => link.addEventListener('click', () => {
      dashboard.querySelector<HTMLDetailsElement>('.dashboard-glossary')!.open = true;
    }));
    const buttons = dashboard.querySelectorAll<HTMLButtonElement>('[data-snapshot]');
    buttons.forEach((button) => button.addEventListener('click', () => {
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      dashboard.querySelectorAll<HTMLElement>('.snapshot-panel').forEach((panel) => { panel.hidden = panel.id !== `snapshot-${button.dataset.snapshot}`; });
      const announcement = dashboard.querySelector('.snapshot-announcement');
      if (announcement) announcement.textContent = `${button.querySelector('.wide-label')?.textContent}. Illustrative dashboard updated.`;
    }));
    dashboard.querySelector<HTMLSelectElement>('#savings-assumption')?.addEventListener('change', (event) => {
      const value = Number((event.target as HTMLSelectElement).value);
      const result = benefitCase(value);
      dashboard.querySelector('[data-roi]')!.textContent = `${Math.round(result.roi)}%`;
      dashboard.querySelector('[data-benefit]')!.textContent = money(result.benefit);
      dashboard.querySelector('[data-net]')!.textContent = money(result.net);
    });
  });
</script>
<style>
  .resilience-dashboard{--dash-accent:#174bc5;font-family:Inter,sans-serif;color:var(--text,#092b3e);width:calc(100% + 160px);margin:64px -80px 72px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);scroll-margin-top:32px}
  :global([data-theme="obsidian"]) .resilience-dashboard{--dash-accent:#91b3ff}
  *{box-sizing:border-box}h2,h3,h4,p,dl,dd,ol{margin:0}button,select{font:inherit}button,a,select,summary{touch-action:manipulation}button:focus-visible,select:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid var(--dash-accent);outline-offset:4px}
  .dashboard-head{text-align:center;padding:44px 24px 32px}.figure-number,.eyebrow,.metric-label{font-size:11px;letter-spacing:.1em;text-transform:uppercase;font-weight:600}.figure-number{color:var(--dash-accent);margin-bottom:18px}.dashboard-head h2{font:400 clamp(34px,4vw,48px)/1.04 Newsreader,serif;letter-spacing:-.025em}.dashboard-head h2 em{color:var(--dash-accent);font-weight:400}.dashboard-deck{font-size:13px;margin:18px auto;color:var(--text-dim);max-width:480px;line-height:1.7}.sample-label{font-size:11px;font-weight:500;color:var(--text-dim)}.sample-label span{color:var(--dash-accent);margin-right:5px}
