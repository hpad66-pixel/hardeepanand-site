---
import VisualEditor from '../../components/VisualEditor.astro';
import { readFileSync } from 'node:fs';
import ResilienceChain from '../../components/ResilienceChain.astro';
import ResilienceDashboard from '../../components/ResilienceDashboard.astro';
import EditorialInteractions from '../../components/EditorialInteractions.astro';
import ApasSignature from '../../components/ApasSignature.astro';
import Base from '../../layouts/Base.astro';
import '../../styles/illustrated-essay.css';
import { readArticles, isVisible, renderMarkdown } from '../../lib/content.js';
import { inlineVitalSignsFigures } from '../../lib/illustrated-figures.js';
import { addTakeawayActions } from '../../lib/takeaway-actions.js';
import SubstackDiscussion from '../../components/SubstackDiscussion.astro';

const isProd = import.meta.env.PROD;

export function getStaticPaths() {
  const prod = import.meta.env.PROD;
  return readArticles(['substack/2026', 'linkedin/2026', 'owos/2026', 'author/2026'])
    .filter((p) => isVisible(p.status, prod))
    .map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
// Drop cap on the first paragraph; the prose styles handle pull quotes and sources.
const prose = renderMarkdown(post.body).replace('<p>', '<p class="first">');
const isGovernance = post.slug === 'governance-at-operating-speed';
const illustrated = post.slug === 'vital-signs' || isGovernance;
const governanceBody = isGovernance ? prose.replace(/<picture>[\s\S]*?<\/picture>/, `<div class="diagram-stage"><div class="diagram-wide">${readFileSync('public/images/articles/governance-at-operating-speed/disclosures.svg','utf8')}</div><div class="diagram-mobile">${readFileSync('public/images/articles/governance-at-operating-speed/disclosures-mobile.svg','utf8')}</div></div>`) : prose;
const html = isGovernance ? addTakeawayActions(governanceBody, post.title, new URL(`/writing/${post.slug}/`, Astro.site).href) : post.slug === 'vital-signs' ? addTakeawayActions(inlineVitalSignsFigures(prose), post.title, new URL(`/writing/${post.slug}/`, Astro.site).href) : prose;
const dashboardParts = isGovernance ? html.split(/(<!-- (?:resilience-dashboard|resilience-chain) -->)/) : [html];
const words = (post.body || '').split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(words / 220));
---
<Base title={post.title} active="/writing/" description={post.description}>
  <article class:list={['post', { 'illustrated-essay': illustrated }]}>
    <header class="post-head">
      <a class="kicker" href="/writing/">The Systems Lens</a>
      <h1>{post.title}</h1>
      <p class="post-byline">
        <span class="av">HA</span>
        <span>Hardeep Anand · {post.date} · {readMin} min read</span>
        {!isProd && post.status !== 'PUBLISHED' && <span class="ribbon">{post.status}</span>}
      </p>
    </header>
    {dashboardParts.map(part => part === '<!-- resilience-dashboard -->' ? <ResilienceDashboard /> : part === '<!-- resilience-chain -->' ? <ResilienceChain /> : <div class="prose" set:html={part} />)}
    <ApasSignature article={post.title} path={`writing/${post.slug}`} />
    <SubstackDiscussion />
  </article>
  <section class="post-end">
    <div class="author">
      <span class="av">HA</span>
      <div>
        <div class="nm">Hardeep Anand</div>
        <p>Thirty years inside water infrastructure, now building the intelligence layer it was missing. The Systems Lens is where the thinking lives, in plain language, every claim sourced.</p>
        <p style="margin-top:14px"><a class="btn solid" href="/#newsletter" style="display:inline-block">Subscribe to The Systems Lens</a></p>
      </div>
    </div>
  </section>
<VisualEditor path={`writing/${post.slug}`} />
</Base>

<EditorialInteractions />
