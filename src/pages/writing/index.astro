---
import Base from '../../layouts/Base.astro';
import CollectionSearch from '../../components/CollectionSearch.astro';
import { publicPages } from '../../lib/published.js';
import { readArticles, isVisible } from '../../lib/content.js';
const isProd = import.meta.env.PROD;
const originalPosts = readArticles(['substack/2026', 'linkedin/2026', 'owos/2026', 'author/2026']).filter((p) => isVisible(p.status, isProd));
const posts = [...originalPosts, ...publicPages.filter(p=>p.path.startsWith('writing/')).map(p=>({...p,slug:p.path.split('/')[1]}))].sort((a,b)=>b.date.localeCompare(a.date));
---
<Base
  title="Writing"
  active="/writing/"
  description="The Systems Lens. Essays on reading infrastructure like a living system."
>
  <section class="page-head">
    <p class="kicker">The Systems Lens</p>
    <h1>Writing</h1>
    <p class="lede">Essays on reading infrastructure like a living system. Long-form, every claim sourced.</p>
  </section>

  <CollectionSearch label="Find an essay"/>
  <ul class="post-list">
    {posts.map((p) => (
      <li class="post-row" data-search>
        <a href={`/writing/${p.slug}/`}>
          <span class="post-meta">
            <time>{p.date}</time>
            {!isProd && p.status !== 'PUBLISHED' && <span class="ribbon">{p.status}</span>}
          </span>
          <span class="post-title">{p.title}</span>
          {p.description && <span class="post-desc">{p.description}</span>}
        </a>
      </li>
    ))}
  </ul>
  {posts.length === 0 && <p class="empty">New essays will appear here.</p>}
</Base>
