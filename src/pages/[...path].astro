---
import VisualEditor from '../components/VisualEditor.astro';
import '../styles/illustrated-essay.css';
import SubstackDiscussion from '../components/SubstackDiscussion.astro';
import EditorialInteractions from '../components/EditorialInteractions.astro';
import { illustrateCompanion } from '../lib/companion-articles.js';
import { illustrateSecondClimb } from '../lib/second-climb.js';
import ApasSignature from '../components/ApasSignature.astro';
import Base from '../layouts/Base.astro';
import { visiblePages } from '../lib/published.js';
export function getStaticPaths() { return visiblePages(import.meta.env.PROD).map(post => ({params:{path:post.path},props:{post}})); }
const { post } = Astro.props;
const group='The Systems Lens';
const active='/writing/';
const readMin=Math.max(1,Math.round(post.body.replace(/<[^>]+>/g,' ').split(/\s+/).length/220));
---
<Base title={post.title} description={post.description} active={active}><article class:list={['post', {'illustrated-essay': ['writing/data-governance','writing/fifty-steps-back','climb/adapt-dont-pivot','climb/in-your-head'].includes(post.path)}]}><header class="post-head"><a class="kicker" href={active}>{group}</a><h1>{post.title}</h1><p class="post-byline"><span class="av">HA</span><span>Hardeep Anand · <time datetime={post.date}>{post.date}</time> · {readMin} min read</span>{post.status!=='PUBLISHED'&&<span class="ribbon">{post.status}</span>}</p></header><div class="prose" set:html={post.path.startsWith('climb/') ? illustrateSecondClimb(post) : illustrateCompanion(post)}/><ApasSignature article={post.title} path={post.path} /><SubstackDiscussion slug={post.path.split('/')[1]} /></article><section class="post-end"><a class="text-link" href={active}>← Back to {group}</a><div class="author" style="margin-top:28px"><span class="av">HA</span><div><div class="nm">Hardeep Anand</div><p>Water, infrastructure, and the intelligence that connects them.</p><a class="text-link" href="/#newsletter">Subscribe to The Systems Lens ↗</a></div></div></section><VisualEditor path={post.path} />
</Base>

<EditorialInteractions />
