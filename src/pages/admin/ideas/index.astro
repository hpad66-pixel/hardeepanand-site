---
import AdminBase from '../../../layouts/AdminBase.astro';
---
<AdminBase title="Private idea library" active="ideas">
  <div class="admin-top"><div><p class="eyebrow">YOUR PRIVATE WORKSPACE</p><h1>A place for the unfinished.</h1><p class="sub">Conversations, working ideas, and the connections taking shape.</p></div><button class="abtn primary" id="add-idea">Upload an idea +</button></div>
  <div class="library-toolbar"><label for="idea-search">Find an idea</label><input id="idea-search" type="search" placeholder="Search titles, summaries, and tags"/><span id="idea-count"></span></div>
  <p id="library-status" role="status">Loading your private library…</p><div id="idea-grid" class="idea-grid"></div><button class="abtn" id="load-more" hidden>Load more</button>
  <p class="library-note">Only your authorized account can list, read, or download these files. Uploads stay in private storage and are never published to the site.</p>
  <dialog id="upload-dialog"><form id="upload-form"><div class="dialog-head"><h2>Keep an idea.</h2><button type="button" class="abtn close-dialog" aria-label="Close upload">Close ×</button></div><p>Upload an HTML transcript, recording card, or working document.</p><label>Title<input name="title" required maxlength="140"/></label><label>A few words of context<textarea name="summary" maxlength="500" rows="3"></textarea></label><label>Tags, separated by commas<input name="tags" placeholder="water, leadership, systems" maxlength="490"/></label><label>HTML file · up to 5 MB<input type="file" name="file" accept=".html,.htm,text/html" required/></label><p id="upload-status" role="status"></p><button type="submit" class="abtn primary" id="upload-submit">Save to my library</button></form></dialog>
  <dialog id="reader-dialog" class="reader"><div class="dialog-head"><h2 id="reader-title"></h2><div><a class="abtn" id="download-idea">Download original</a><button class="abtn close-dialog" aria-label="Close reader">Close ×</button></div></div><p class="reader-note">Reading view preserves inline formatting. Scripts and external resources are disabled; download the original to use its interactive features locally.</p><iframe id="idea-frame" title="Private idea document" sandbox="" referrerpolicy="no-referrer"></iframe></dialog>
</AdminBase>
<style>
.eyebrow{font-size:11px;letter-spacing:.17em;color:var(--accent);margin-bottom:12px}.library-toolbar{display:flex;gap:18px;align-items:center;flex-wrap:wrap;margin:36px 0 20px}.library-toolbar label{font-size:13px}.library-toolbar input{flex:1;min-width:200px;padding:14px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--text)}.library-toolbar span{font-size:12px;color:var(--text-dim)}.idea-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.idea-grid :global(.idea-card){text-align:left;padding:26px;background:var(--surface);border:1px solid var(--line);border-radius:12px;color:var(--text);cursor:pointer;min-height:220px;display:flex;flex-direction:column;align-items:flex-start;gap:15px}.idea-grid :global(.idea-card:hover){border-color:var(--accent)}.idea-grid :global(h2){font-family:var(--font-display);font-size:28px;line-height:1.2;margin:0}.idea-grid :global(p){color:var(--text-dim);font-size:14px;line-height:1.6;margin:0}.idea-grid :global(small){font-size:11px;color:var(--accent)}.idea-grid :global(.tags){margin-top:auto}.library-note{margin-top:32px;max-width:70ch;font-size:12px;color:var(--text-dim)}dialog{border:1px solid var(--line);border-radius:16px;background:var(--surface);color:var(--text);padding:30px;width:min(600px,calc(100vw - 32px));max-height:90vh;margin:auto}dialog::backdrop{background:#06283dcc;backdrop-filter:blur(5px)}.dialog-head{display:flex;align-items:center;justify-content:space-between;gap:20px}.dialog-head h2{font-family:var(--font-display);font-size:32px;margin:0}.dialog-head>div{display:flex;gap:10px}form label{display:block;font-size:13px;margin:20px 0}form input,form textarea{display:block;width:100%;margin-top:8px;padding:12px;border:1px solid var(--line);border-radius:7px;background:var(--bg);color:var(--text);font:inherit}form p{color:var(--text-dim);font-size:14px}dialog.reader{width:calc(100vw - 40px);max-width:1400px;height:92vh;max-height:92vh;padding:22px}iframe{width:100%;height:calc(100% - 110px);border:0;background:white}.reader-note{font-size:12px;color:var(--text-dim);margin:14px 0}#library-status{color:var(--text-dim)}@media(max-width:1100px){.idea-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.idea-grid{grid-template-columns:1fr}.dialog-head{align-items:flex-start;flex-direction:column}.dialog-head h2{font-size:25px}iframe{height:calc(100% - 165px)}dialog{padding:20px}.library-toolbar{gap:10px}.library-toolbar input{flex-basis:100%}}
</style>
<script>
const get=(id:string)=>document.getElementById(id)!;
const upload=get('upload-dialog') as HTMLDialogElement,reader=get('reader-dialog') as HTMLDialogElement;
const frame=get('idea-frame') as HTMLIFrameElement,form=get('upload-form') as HTMLFormElement;
let items:any[]=[],cursor:string|null=null;
get('add-idea').onclick=()=>upload.showModal();
document.querySelectorAll('.close-dialog').forEach(button=>button.addEventListener('click',()=>button.closest('dialog')?.close()));
reader.addEventListener('close',()=>frame.removeAttribute('src'));
function render(){const term=(get('idea-search') as HTMLInputElement).value.toLowerCase();const matches=items.filter(i=>[i.title,i.summary,...i.tags].join(' ').toLowerCase().includes(term));get('idea-grid').replaceChildren();get('idea-count').textContent=`${items.length} idea${items.length===1?'':'s'}`;for(const item of matches){const card=document.createElement('button');card.className='idea-card';const date=document.createElement('small');date.textContent=new Date(item.createdAt).toLocaleDateString(undefined,{month:'short',day:'numeric',year:'numeric'});const title=document.createElement('h2');title.textContent=item.title;const summary=document.createElement('p');summary.textContent=item.summary;const tags=document.createElement('small');tags.className='tags';tags.textContent=item.tags.map((t:string)=>`#${t}`).join('  ');card.append(date,title,summary,tags);card.onclick=()=>{get('reader-title').textContent=item.title;(get('download-idea') as HTMLAnchorElement).href=`/admin/ideas/${item.id}?download=1`;frame.src=`/admin/ideas/${item.id}`;reader.showModal();};get('idea-grid').append(card);}get('library-status').textContent=matches.length?'':items.length?'No ideas match your search.':'Your library is ready. Upload your first idea to begin.';get('load-more').hidden=!cursor;}
async function load(more=false){try{const response=await fetch('/admin/ideas/api'+(more&&cursor?'?cursor='+encodeURIComponent(cursor):''),{cache:'no-store'});if(!response.ok)throw new Error(response.status===403?'Sign in with your authorized account to open the library.':'The library is unavailable. Please refresh and try again.');const data=await response.json();items=more?[...items,...data.items]:data.items;items.sort((a,b)=>b.createdAt.localeCompare(a.createdAt));cursor=data.cursor;render();}catch(error){get('library-status').textContent=(error as Error).message;}}
get('idea-search').addEventListener('input',render);get('load-more').onclick=()=>load(true);
form.addEventListener('submit',async event=>{event.preventDefault();const button=get('upload-submit') as HTMLButtonElement;button.disabled=true;get('upload-status').textContent='Saving privately…';try{const file=(form.elements.namedItem('file') as HTMLInputElement).files?.[0];if(!file||file.size>5*1024*1024)throw new Error('Choose an HTML file up to 5 MB.');const response=await fetch('/admin/ideas/api',{method:'POST',body:new FormData(form)});const data=await response.json();if(!response.ok)throw new Error(data.error||'Upload failed.');form.reset();get('upload-status').textContent='';upload.close();await load();}catch(error){get('upload-status').textContent=(error as Error).message;}finally{button.disabled=false;}});
load();
</script>
