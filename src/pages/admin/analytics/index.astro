---
import AdminBase from '../../../layouts/AdminBase.astro';
---
<AdminBase title="Analytics" active="analytics">
  <div class="admin-top">
    <div>
      <h1>Audience analytics</h1>
      <div class="sub">See where readers come from, which articles pull attention, and which channels deserve marketing follow-up.</div>
    </div>
    <div class="actions">
      <a class="abtn" href="/admin/content/">Manage content</a>
      <button class="abtn primary" data-refresh>Refresh</button>
    </div>
  </div>

  <div class="stats">
    <div class="stat"><div class="k">PAGEVIEWS</div><div class="v" data-total-views>0</div><div class="d">last 30 days</div></div>
    <div class="stat"><div class="k">VISITORS</div><div class="v" data-total-visitors>0</div><div class="d">privacy-safe estimate</div></div>
    <div class="stat"><div class="k">TOP COUNTRY</div><div class="v small" data-top-country>--</div><div class="d">by pageviews</div></div>
    <div class="stat"><div class="k">TOP SOURCE</div><div class="v small" data-top-source>--</div><div class="d">referrer or campaign</div></div>
  </div>

  <section class="analytics-grid">
    <div class="panel">
      <div class="panel-h"><h2>Traffic trend</h2><span class="lk">30 days</span></div>
      <div class="panel-b"><div class="bars" data-bars></div></div>
    </div>
    <div class="panel geo-panel">
      <div class="panel-h"><h2>World signal</h2><span class="lk">map + US regions</span></div>
      <div class="panel-b"><div class="world-map" data-world-map aria-label="Reader locations by country and US region"></div></div>
    </div>
    <div class="panel"><div class="panel-h"><h2>Top content</h2><span class="lk">what readers choose</span></div><div class="panel-b"><div class="rank-list" data-rank="topPaths"></div></div></div>
    <div class="panel"><div class="panel-h"><h2>Sources</h2><span class="lk">marketing channels</span></div><div class="panel-b"><div class="rank-list" data-rank="referrers"></div></div></div>
    <div class="panel"><div class="panel-h"><h2>Campaigns</h2><span class="lk">UTM tags</span></div><div class="panel-b"><div class="rank-list" data-rank="campaigns"></div></div></div>
    <div class="panel"><div class="panel-h"><h2>Regions</h2><span class="lk">country / region</span></div><div class="panel-b"><div class="rank-list" data-rank="regions"></div></div></div>
  </section>

  <p class="admin-note">Analytics are first-party and lightweight. The system stores aggregate path, country, referrer, campaign, and device counts in Cloudflare KV without raw IP addresses.</p>

  <script type="module">
    const fmt = n => Intl.NumberFormat().format(n || 0);
    const countryPositions = {
      US: [24, 40], CA: [20, 26], MX: [20, 52], GB: [47, 30], UK: [47, 30], IE: [45, 31],
      FR: [49, 36], DE: [51, 34], NL: [50, 32], ES: [47, 42], IT: [53, 42],
      IN: [70, 47], CN: [76, 39], JP: [86, 42], AU: [80, 72], BR: [34, 72],
      ZA: [56, 78], AE: [63, 49], SG: [76, 59],
    };
    const usStatePositions = {
      Alabama: [68, 69], Alaska: [10, 83], Arizona: [25, 62], Arkansas: [57, 62], California: [13, 53],
      Colorado: [37, 48], Connecticut: [86, 37], Delaware: [82, 49], Florida: [75, 81], Georgia: [71, 69],
      Hawaii: [29, 84], Idaho: [28, 32], Illinois: [61, 45], Indiana: [66, 46], Iowa: [55, 42],
      Kansas: [47, 51], Kentucky: [68, 54], Louisiana: [57, 75], Maine: [91, 22], Maryland: [80, 49],
      Massachusetts: [88, 35], Michigan: [68, 34], Minnesota: [54, 28], Mississippi: [62, 69],
      Missouri: [57, 52], Montana: [36, 26], Nebraska: [47, 43], Nevada: [21, 47], 'New Hampshire': [88, 28],
      'New Jersey': [83, 45], 'New Mexico': [34, 62], 'New York': [81, 34], 'North Carolina': [78, 60],
      'North Dakota': [48, 25], Ohio: [72, 46], Oklahoma: [48, 59], Oregon: [17, 35], Pennsylvania: [78, 43],
      'Rhode Island': [89, 38], 'South Carolina': [76, 66], 'South Dakota': [47, 34], Tennessee: [66, 60],
      Texas: [44, 75], Utah: [29, 50], Vermont: [86, 28], Virginia: [79, 55], Washington: [18, 25],
      'West Virginia': [75, 52], Wisconsin: [61, 34], Wyoming: [37, 37], District: [81, 51],
    };
    function text(tag, value, className) {
      const el = document.createElement(tag);
      if (className) el.className = className;
      el.textContent = value || '';
      return el;
    }
    function renderRank(container, items) {
      container.replaceChildren();
      if (!items || !items.length) {
        container.append(text('div', 'No traffic recorded yet.', 'cms-empty'));
        return;
      }
      const max = Math.max(1, ...items.map(item => item.value));
      for (const item of items) {
        const row = document.createElement('div');
        row.className = 'rank-row';
        const label = text('span', item.label);
        const value = text('b', fmt(item.value));
        const meter = document.createElement('i');
        meter.style.setProperty('--w', `${Math.round(item.value / max * 100)}%`);
        row.append(label, value, meter);
        container.append(row);
      }
    }
    function renderBars(days) {
      const bars = document.querySelector('[data-bars]');
      bars.replaceChildren();
      const peak = Math.max(1, ...(days || []).map(day => day.views || 0));
      for (const day of days || []) {
        const bar = document.createElement('span');
        bar.style.setProperty('--h', `${Math.max(4, Math.round((day.views || 0) / peak * 100))}%`);
        bar.title = `${day.day}: ${day.views || 0} views`;
        bar.append(text('b', String(day.views || 0)));
        bars.append(bar);
      }
    }
    function cleanLabel(value) {
      return String(value || '').replace(/^United States\s*\/\s*/i, 'US / ').trim();
    }
    function countryCode(label) {
      const value = String(label || '').trim();
      if (/^(United States|USA|US)$/i.test(value)) return 'US';
      if (/^(United Kingdom|UK)$/i.test(value)) return 'GB';
      if (/^Canada$/i.test(value)) return 'CA';
      if (/^India$/i.test(value)) return 'IN';
      if (/^Australia$/i.test(value)) return 'AU';
      return value.length === 2 ? value.toUpperCase() : value.slice(0, 2).toUpperCase();
    }
    function usRegionName(label) {
      const parts = cleanLabel(label).split('/').map(part => part.trim()).filter(Boolean);
      if (parts[0] !== 'US' || !parts[1]) return '';
      return parts[1];
    }
    function sizeFor(value, max, base = 10, spread = 24) {
      return base + Math.round((value || 0) / Math.max(1, max) * spread);
    }
    function mapDot(item, left, topPos, max, className) {
      const dot = document.createElement('span');
      dot.className = className;
      const size = sizeFor(item.value, max);
      dot.style.left = `${left}%`;
      dot.style.top = `${topPos}%`;
      dot.style.width = `${size}px`;
      dot.style.height = `${size}px`;
      dot.title = `${item.label}: ${item.value}`;
      return dot;
    }
    function renderMap(countries, regions = []) {
      const map = document.querySelector('[data-world-map]');
      map.replaceChildren();
      const topCountries = (countries || []).slice(0, 8);
      const usRegions = (regions || []).map(item => ({ ...item, region: usRegionName(item.label) })).filter(item => item.region).slice(0, 8);
      const frame = document.createElement('div');
      frame.className = 'map-frame';
      frame.innerHTML = `
        <svg class="world-silhouette" viewBox="0 0 960 520" role="img" aria-label="Stylized world map and United States inset">
          <path class="land" d="M120 142c42-50 145-66 214-33 44 21 34 65-7 78-36 11-41 47-83 59-50 15-130-23-153-67-9-17 6-29 29-37Z"/>
          <path class="land" d="M292 273c47 22 73 67 58 122-12 43-48 74-75 59-25-14-12-55-36-84-26-31-22-76 18-94 10-5 22-6 35-3Z"/>
          <path class="land" d="M440 142c74-34 159-12 164 40 4 40-52 55-83 39-34-18-88 19-105-13-12-23 0-52 24-66Z"/>
          <path class="land" d="M530 246c50-24 109-12 141 31 28 38 12 104-36 135-34 22-93-8-96-51-2-29-37-37-33-70 2-19 10-35 24-45Z"/>
          <path class="land" d="M637 149c82-45 202-4 220 65 12 46-35 83-89 70-42-10-50 28-93 21-64-10-104-52-95-101 4-23 24-39 57-55Z"/>
          <path class="land" d="M733 366c51-9 109 16 120 55 8 30-25 54-74 49-42-4-72-26-68-57 2-22 7-39 22-47Z"/>
          <path class="us-land" d="M92 322c54-30 148-36 225-19 41 9 90 18 130 11 23-4 39 10 32 31-9 27-49 28-70 52-34 39-123 48-185 29-50-15-62-50-104-54-35-3-50-32-28-50Z"/>
          <text x="86" y="294" class="map-title">United States detail</text>
        </svg>`;
      const globalMax = Math.max(1, ...topCountries.map(item => item.value));
      topCountries.forEach((item, index) => {
        const [left, topPos] = countryPositions[countryCode(item.label)] || [48 + (index % 4) * 9, 36 + Math.floor(index / 4) * 18];
        frame.append(mapDot(item, left, topPos, globalMax, 'map-dot global-dot'));
      });
      const usMax = Math.max(1, ...usRegions.map(item => item.value));
      usRegions.forEach((item, index) => {
        const [left, topPos] = usStatePositions[item.region] || [22 + (index % 5) * 12, 66 + Math.floor(index / 5) * 8];
        frame.append(mapDot({ ...item, label: cleanLabel(item.label) }, left, topPos, usMax, 'map-dot us-dot'));
      });
      const labels = document.createElement('div');
      labels.className = 'map-labels';
      const labelItems = usRegions.length ? usRegions.map(item => ({ ...item, label: cleanLabel(item.label) })) : topCountries;
      labelItems.forEach(item => {
        const label = text('span', item.label);
        label.append(text('b', fmt(item.value)));
        labels.append(label);
      });
      if (!topCountries.length && !usRegions.length) {
        labels.append(text('span', 'No location data yet.'));
      }
      frame.append(labels);
      map.append(frame);
    }
    async function load() {
      const response = await fetch('/api/admin/analytics?days=30', { credentials: 'same-origin' });
      let data;
      if (response.ok && (response.headers.get('content-type') || '').includes('application/json')) {
        data = await response.json();
      } else {
        data = { days: Array.from({ length: 30 }, (_, index) => ({ day: String(index + 1), views: 0, visitors: 0 })), totals: { views: 0, visitors: 0 }, topPaths: [], countries: [], referrers: [], campaigns: [], regions: [] };
      }
      if (data.error) throw new Error(data.error);
      document.querySelector('[data-total-views]').textContent = fmt(data.totals.views);
      document.querySelector('[data-total-visitors]').textContent = fmt(data.totals.visitors);
      document.querySelector('[data-top-country]').textContent = data.countries?.[0]?.label || '--';
      document.querySelector('[data-top-source]').textContent = data.referrers?.[0]?.label || data.campaigns?.[0]?.label || '--';
      renderBars(data.days);
      renderMap(data.countries, data.regions);
      for (const key of ['topPaths', 'referrers', 'campaigns', 'regions']) renderRank(document.querySelector(`[data-rank="${key}"]`), data[key]);
    }
    document.querySelector('[data-refresh]').addEventListener('click', () => load());
    load().catch(error => {
      const bars = document.querySelector('[data-bars]');
      bars.replaceChildren(text('div', error.message, 'cms-empty'));
    });
  </script>
</AdminBase>
