---
import Base from '../layouts/Base.astro';
import { copy as c } from '../data/copy.js';
import { readArticles, isVisible } from '../lib/content.js';
const posts = readArticles(['substack/2026', 'linkedin/2026', 'owos/2026', 'author/2026']).filter(p => isVisible(p.status, import.meta.env.PROD));
const featured = posts.find(p => p.slug === 'vital-signs') || posts[0];
---
<Base title="Hardeep Anand" active="/" description="Three decades inside water infrastructure. A new lens on its future. Explore Hardeep Anand’s essays on water, systems thinking, and artificial intelligence.">
  <section class="hero">
    <div class="hero-inner hero-grid">
      <div class="hero-copy">
        <p class="meta-label"><span class="small-rule"></span> THE OPERATOR’S PERSPECTIVE</p>
        <h1><span data-edit="home.headline">{c['home.headline']}</span><br/><em data-edit="home.headlineAccent">{c['home.headlineAccent']}</em></h1>
        <p class="sub" data-edit="home.lede">{c['home.lede']}</p>
        <div class="cta-row"><a class="btn solid" href="/writing/">Explore the writing <span aria-hidden="true">↗</span></a><a class="text-link" href="/about/">Meet Hardeep <span aria-hidden="true">→</span></a></div>
        <div class="hero-author"><img src="/portrait.jpg" alt="Hardeep Anand" width="48" height="48"/><div><strong>Hardeep Anand, P.E.</strong><span>Operator. Builder. Systems thinker.</span></div></div>
      </div>
      <figure class="hero-art"><img src="/images/estuary.webp" alt="Conceptual aerial artwork of branching waterways, echoing the connections in a living system" width="1100" height="1375" fetchpriority="high"/><div class="art-top"><span>FIELD OF VIEW / 001</span><span aria-hidden="true">↗</span></div><figcaption><span>Everything is connected.</span><span>Start seeing the system.</span></figcaption></figure>
    </div>
    <div class="hero-bottom"><span>WATER. INFRASTRUCTURE. INTELLIGENCE.</span><a href="#perspective">A different perspective <span aria-hidden="true">↓</span></a></div>
  </section>
  <section class="perspective wrap" id="perspective">
    <div class="section-label"><span class="index">01 /</span> THE THROUGH LINE</div>
    <div><h2>Thirty years inside the system.<br/><em>A new lens on what comes next.</em></h2><p class="section-intro">Water doesn’t move in silos. Neither should the knowledge we use to manage it. My work connects the operator’s experience with the possibilities of AI, grounded in a simple conviction: <strong>data ready before AI ready.</strong></p>
      <div class="proof-grid"><div class="stat"><span class="v">30<span> years</span></span><span class="k">Inside water infrastructure</span></div><div class="stat"><span class="v">~$1B<span> / yr</span></span><span class="k">Capital program experience</span></div><div class="stat"><span class="v">P.E.</span><span class="k">Professional engineer</span></div></div>
    </div>
  </section>
  {featured && <section class="featured-essay wrap"><div class="section-heading"><p class="section-label"><span class="index">02 /</span> THE SYSTEMS LENS</p><a class="text-link" href="/writing/">All writing <span aria-hidden="true">↗</span></a></div><a class="essay-feature" href={`/writing/${featured.slug}/`}><div class="essay-plate"><span class="meta-label">A QUESTION WORTH ASKING</span><blockquote>Did the system<br/>get <em>healthier?</em></blockquote><span class="plate-foot">THE CURVE TEST <span aria-hidden="true">↗</span></span></div><div class="essay-copy"><div class="post-meta"><span>FEATURED ESSAY</span><span>·</span><span>{Math.max(1, Math.round(featured.body.split(/\s+/).length / 220))} MIN READ</span></div><h2>{featured.title}</h2><p>{featured.description}</p><span class="text-link">Read the essay <span aria-hidden="true">↗</span></span></div></a></section>}
  <section class="doors wrap"><div class="section-heading"><p class="section-label"><span class="index">03 /</span> EXPLORE THE IDEAS</p><span class="quiet">Different depths. One connected view.</span></div><div class="door-grid"><a class="door" href="/writing/"><span class="door-top">ESSAYS & PERSPECTIVES <span aria-hidden="true">↗</span></span><h3>The Systems<br/><em>Lens.</em></h3><p>Read infrastructure like a living system. Long-form thinking, grounded in the operator’s experience.</p><span class="door-bottom">Go deeper <span aria-hidden="true">→</span></span></a><a class="door" href="/lexicon/"><span class="door-top">THE LANGUAGE OF WATER <span aria-hidden="true">↗</span></span><h3>OneWater<br/><em>Lexicon.</em></h3><p>Make the technical tangible. Water concepts explained through the systems we already understand.</p><span class="door-bottom">Find clarity <span aria-hidden="true">→</span></span></a><a class="door" href="/minute/"><span class="door-top">ONE IDEA. ONE MINUTE. <span aria-hidden="true">↗</span></span><h3>OneWater<br/><em>Minute.</em></h3><p>A short read that changes how you see the bigger picture. The smallest useful unit of the work.</p><span class="door-bottom">Take a minute <span aria-hidden="true">→</span></span></a></div></section>
  <section class="film-section wrap"><div class="film-copy"><p class="section-label"><span class="index">04 /</span> IN MOTION</p><h2>The invisible,<br/><em>made visible.</em></h2><p>A short introduction to the work and the perspective behind it.</p><span class="quiet">00:34 · Brand film · No audio</span></div><video class="vsl-video" src="/vsl.mp4" controls playsinline preload="metadata" aria-label="Hardeep Anand brand film, 34 seconds, no audio"></video></section>
  <section class="newsletter wrap" id="newsletter"><div class="nl-card"><div><p class="section-label">LET’S KEEP THINKING</p><h2>A clearer view.<br/><em>Delivered.</em></h2><p>The Systems Lens brings together water, infrastructure, and intelligence. Read the next essay in your inbox.</p></div><div class="nl-action"><form class="nl-form" action="https://www.thesystemslens.com/subscribe" method="get"><label for="newsletter-email">Your email address</label><div class="nl-input-row"><input id="newsletter-email" type="email" name="email" placeholder="you@example.com" autocomplete="email" required/><button type="submit" aria-label="Continue to subscribe">Subscribe <span aria-hidden="true">↗</span></button></div></form><p class="nl-note">Continue to The Systems Lens to confirm your subscription.<br/>Prefer a reader? <a href="/rss.xml">Follow the RSS feed.</a></p></div></div></section>
</Base>
