---
import '../styles/notebook-home.css';
import '../styles/home-editorial.css';
import ReaderSignup from '../components/ReaderSignup.astro';
import Base from '../layouts/Base.astro';
import ReadingRoom from '../components/ReadingRoom.astro';
import { readingLibrary } from '../lib/reading-library.js';
import { visualIndex } from '../lib/discovery.js';
import { selectHomepageStories, visualForPost } from '../lib/homepage.js';
const posts = readingLibrary(true);
const figures = visualIndex(posts);
const homepage = selectHomepageStories(posts);
const lead = homepage.lead;
const leadVisual = visualForPost(lead, figures);
const supportingStories = homepage.supporting.map((post) => ({ post, visual: visualForPost(post, figures) }));
const evergreenStory = homepage.evergreen ? { post: homepage.evergreen, visual: visualForPost(homepage.evergreen, figures) } : null;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'The Systems Lens',
    url: 'https://hardeepanand.com/',
    description: 'The Systems Lens by Hardeep Anand. Essays on water, infrastructure, AI, and learning.',
    author: { '@type': 'Person', name: 'Hardeep Anand', url: 'https://hardeepanand.com/about/' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Latest Systems Lens writing',
    itemListElement: [lead, ...homepage.supporting, homepage.evergreen].filter(Boolean).map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(post.href, 'https://hardeepanand.com').href,
      name: post.title,
    })),
  },
];
---
<Base title="The Systems Lens" active="/" description="The Systems Lens by Hardeep Anand. Essays on water, AI, and learning, with useful ideas to put into practice." structuredData={structuredData}>
  <div class="notebook-home">
    <header class="lens-opening">
      <div class="lens-opening-copy">
        <p class="lens-eyebrow"><span></span> WATER &middot; INTELLIGENCE &middot; HUMAN POSSIBILITY</p>
        <h1>The Systems Lens</h1>
        <p class="lens-thesis">I make invisible<br/>systems <em>legible.</em></p>
        <p class="lens-deck">A river. A utility. A life in motion.<br/>Nothing works in isolation. When we see the connections, we can find a better way forward.</p>
        <div class="lens-opening-actions"><a class="lens-primary" href="#essays">Explore the writing <span aria-hidden="true">&#8595;</span></a><a href="/#newsletter">Join the conversation <span aria-hidden="true">&#8599;</span></a></div>
        <a class="lens-meet" href="/about/"><img src="/portrait.jpg" width="64" height="64" alt="Hardeep Anand"/><span><strong>Meet Hardeep</strong><small>Engineer. Operator. Lifelong learner.</small></span><span aria-hidden="true">&#8599;</span></a>
      </div>
      <figure class="lens-rivers">
        <img src="/images/estuary.webp" width="1100" height="1375" fetchpriority="high" alt="Illustrative aerial view of branching waterways joining a wider estuary."/>
        <div class="river-register" aria-hidden="true"><span>FIELD NOTES / 001</span></div>
        <figcaption><span>Look closer.</span><strong>Everything<br/>is connected.</strong><small>Water makes the invisible visible. Illustrative artwork.</small></figcaption>
      </figure>
    </header>
    {lead && <section class="notebook-latest notebook-width" aria-labelledby="latest-title">
      <div class="notebook-latest-head">
        <div>
          <p class="notebook-label">LATEST WRITING</p>
          <h2 id="latest-title">The newest three stay on top.</h2>
        </div>
        <p>Latest-first by default, with one evergreen slot Hardeep can pin when a cornerstone idea should stay visible.</p>
      </div>
      <article class="latest-lead" data-content-path={lead.href}>
        <a class="latest-visual" href={lead.href} aria-label={`Read ${lead.title}`}>
          {leadVisual.image ? <picture>
            {leadVisual.mobileImage && <source media="(max-width: 600px)" srcset={leadVisual.mobileImage} />}
            <img src={leadVisual.image} alt={leadVisual.title} width="900" height="560" loading="lazy" decoding="async" />
          </picture> : <span>{lead.topic}</span>}
        </a>
        <div class="latest-copy">
          <p class="notebook-label">NEWEST FEATURE <span>{lead.readMin} MIN READ</span></p>
          <h3><a href={lead.href}>{lead.title}</a></h3>
          <p>{lead.summary}</p>
          <p class="latest-takeaway"><strong>Take this with you</strong>{lead.takeaway}</p>
          <div class="latest-actions">
            <a class="lens-primary" href={lead.href}>Read the essay <span aria-hidden="true">&#8599;</span></a>
            <a href="/writing/">View all writing</a>
          </div>
        </div>
      </article>
      <div class="latest-supporting" aria-label="Recent and pinned writing">
        {supportingStories.map(({ post, visual }, index) => <article class="latest-card" data-content-path={post.href}>
          <span class="latest-card-mark" aria-hidden="true">{visual.image ? <img src={visual.image} alt="" loading="lazy" decoding="async" /> : post.title.slice(0, 1)}</span>
          <div>
            <p class="notebook-label">LATEST {String(index + 2).padStart(2, '0')}</p>
            <h3><a href={post.href}>{post.title}</a></h3>
            <p>{post.summary}</p>
          </div>
        </article>)}
        {evergreenStory && <article class="latest-card evergreen-card" data-content-path={evergreenStory.post.href}>
          <span class="latest-card-mark" aria-hidden="true">{evergreenStory.visual.image ? <img src={evergreenStory.visual.image} alt="" loading="lazy" decoding="async" /> : 'E'}</span>
          <div>
            <p class="notebook-label">PINNED EVERGREEN</p>
            <h3><a href={evergreenStory.post.href}>{evergreenStory.post.title}</a></h3>
            <p>{evergreenStory.post.summary}</p>
          </div>
        </article>}
      </div>
    </section>}
    <ReadingRoom posts={posts} showFeature={false} />
    <section class="notebook-response notebook-width" aria-labelledby="response-title">
      <div>
        <p class="notebook-label">THOUGHTFUL RESPONSE LAYER</p>
        <h2 id="response-title">Not reactions. Better questions.</h2>
      </div>
      <p>No public thumbs, counters, or open comment noise. Readers can share, subscribe, ask a private question, or request a diagnostic when an essay connects to real work.</p>
      <div class="response-actions">
        <a href="/follow/">Follow updates <span aria-hidden="true">&#8594;</span></a>
        <a href="/work/">Request a diagnostic <span aria-hidden="true">&#8599;</span></a>
        <a href="mailto:hardeep@apas.ai?subject=A%20question%20from%20The%20Systems%20Lens">Ask Hardeep a question <span aria-hidden="true">&#8599;</span></a>
      </div>
    </section>
    <section class="notebook-about" aria-labelledby="notebook-about-title">
      <div class="notebook-width notebook-about-inner">
        <img src="/portrait.jpg" width="184" height="220" alt="Hardeep Anand" loading="lazy" />
        <div>
          <p class="notebook-label">BEHIND THE WRITING</p>
          <h2 id="notebook-about-title">Meet Hardeep</h2>
          <p>Engineer. Operator. Lifelong learner. Three decades inside water infrastructure inform these essays on the systems we build and the people we become.</p>
          <a href="/about/">The perspective behind the work <span aria-hidden="true">&#8599;</span></a>
        </div>
        <div class="notebook-work-note">
          <h3>A question from your own work?</h3>
          <p>Bring a decision, a data problem, or a learning challenge.</p>
          <a href="/work/">Work with APAS <span aria-hidden="true">&#8599;</span></a>
          <details><summary>A short introduction</summary><video src="/vsl.mp4" controls playsinline preload="none" aria-label="Hardeep Anand introduction, 34 seconds, no audio"></video><p>34 seconds. No audio.</p></details>
        </div>
      </div>
    </section>
    <ReaderSignup />
  </div>
</Base>
