---
import '../styles/notebook-home.css';
import '../styles/home-editorial.css';
import ReaderSignup from '../components/ReaderSignup.astro';
import Base from '../layouts/Base.astro';
import ReadingRoom from '../components/ReadingRoom.astro';
import { readingLibrary } from '../lib/reading-library.js';
const posts = readingLibrary(true);
const featured = posts.find(post => post.slug === 'nature-already-has-the-math') || posts[0];
---
<Base title="The Systems Lens" active="/" description="The Systems Lens by Hardeep Anand. Essays on water, AI, and learning, with useful ideas to put into practice.">
  <div class="notebook-home">
    <header class="lens-opening">
      <div class="lens-opening-copy">
        <p class="lens-eyebrow"><span></span> WATER &middot; INTELLIGENCE &middot; HUMAN POSSIBILITY</p>
        <h1>The Systems Lens</h1>
        <p class="lens-thesis">I make invisible<br/>systems <em>legible.</em></p>
        <p class="lens-deck">A river. A utility. A life in motion.<br/>Nothing works in isolation. When we see the connections, we can find a better way forward.</p>
        <div class="lens-opening-actions"><a class="lens-primary" href="#essays">Explore the writing <span aria-hidden="true">&#8595;</span></a><a href="/#newsletter">Join the conversation <span aria-hidden="true">&#8599;</span></a></div>
        <a class="lens-meet" href="/about/"><img src="/portrait.jpg" width="64" height="64" alt="Hardeep Anand"/><span><strong>Meet Hardeep</strong><small>Engineer. Operator. Lifelong learner.</small></span><span aria-hidden="true">&#8599;</span></a>
      </div>
      <figure class="lens-rivers">
        <img src="/images/estuary.webp" width="1100" height="1375" fetchpriority="high" alt="Illustrative aerial view of branching waterways joining a wider estuary."/>
        <div class="river-register" aria-hidden="true"><span>FIELD NOTES / 001</span></div>
        <figcaption><span>Look closer.</span><strong>Everything<br/>is connected.</strong><small>Water makes the invisible visible. Illustrative artwork.</small></figcaption>
      </figure>
    </header>
    {featured && <section class="notebook-feature notebook-width" aria-labelledby="featured-title">
      <div class="notebook-feature-copy">
        <p class="notebook-label">FEATURED ESSAY <span>{featured.readMin} MIN READ</span></p>
        <h2 id="featured-title"><a href={featured.href}>{featured.title}</a></h2>
        <p class="notebook-feature-summary">{featured.summary}</p>
        <p class="notebook-feature-value"><strong>Take it into your next meeting</strong>{featured.takeaway}</p>
        <a class="notebook-read" href={featured.href}>Read the essay <span aria-hidden="true">&#8599;</span></a>
      </div>
      <figure class="notebook-feature-figure">
        <a href={`${featured.href}#fig-hydrologic`} aria-label="Read the water cycle diagram in Nature Already Has the Math">
          <picture>
            <source media="(max-width: 600px)" srcset="/images/articles/nature-already-has-the-math/fig-hydrologic-mobile.png" />
            <img src="/images/articles/nature-already-has-the-math/fig-hydrologic.png" width="1440" height="1020" alt="The water cycle connects the utility to land, atmosphere, and receiving waters." />
          </picture>
        </a>
        <figcaption>Inside the essay: follow the water across the utility boundary.</figcaption>
      </figure>
    </section>}
    <ReadingRoom posts={posts} showFeature={false} />
    <section class="notebook-about" aria-labelledby="notebook-about-title">
      <div class="notebook-width notebook-about-inner">
        <img src="/portrait.jpg" width="184" height="220" alt="Hardeep Anand" loading="lazy" />
        <div>
          <p class="notebook-label">BEHIND THE WRITING</p>
          <h2 id="notebook-about-title">Meet Hardeep</h2>
          <p>Engineer. Operator. Lifelong learner. Three decades inside water infrastructure inform these essays on the systems we build and the people we become.</p>
          <a href="/about/">The perspective behind the work <span aria-hidden="true">&#8599;</span></a>
        </div>
        <div class="notebook-work-note">
          <h3>A question from your own work?</h3>
          <p>Bring a decision, a data problem, or a learning challenge.</p>
          <a href="/work/">Work with APAS <span aria-hidden="true">&#8599;</span></a>
          <details><summary>A short introduction</summary><video src="/vsl.mp4" controls playsinline preload="none" aria-label="Hardeep Anand introduction, 34 seconds, no audio"></video><p>34 seconds. No audio.</p></details>
        </div>
      </div>
    </section>
    <ReaderSignup />
  </div>
</Base>
