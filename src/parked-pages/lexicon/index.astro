---
import Base from '../../layouts/Base.astro';
import CollectionSearch from '../../components/CollectionSearch.astro';
import { terms } from '../../data/lexicon.js';
import { readHtmlCollection, isVisible } from '../../lib/content.js';
const existing=readHtmlCollection('lexicon').filter(p=>isVisible(p.status,import.meta.env.PROD)&&!terms.some(t=>t.slug===p.slug));
---
<Base title="OneWater Lexicon" active="/lexicon/" description="The language of water, made clear. Explore sourced definitions and practical connections to the systems we operate."><section class="page-head"><p class="kicker">OneWater Lexicon</p><h1>The language<br/><em>of water.</em></h1><p class="lede">Make the technical tangible. Clear definitions, a familiar analogy, and a practical connection to the utility.</p></section><CollectionSearch label="Find a concept"/><ul class="card-grid">{terms.map(t=><li class="card" data-search><a href={`/lexicon/${t.slug}/`}><div><span class="post-meta">{t.category}</span><h2 class="card-title" style="margin:16px 0">{t.title}</h2><p class="quiet">{t.description}</p></div><span aria-hidden="true">↗</span></a></li>)}{existing.map(t=><li class="card" data-search><a href={`/lexicon/${t.slug}.html`}><span class="card-title">{t.title}</span><span aria-hidden="true">↗</span></a></li>)}</ul></Base>
