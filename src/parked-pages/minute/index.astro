---
import Base from '../../layouts/Base.astro';
import { readHtmlCollection, isVisible } from '../../lib/content.js';
const items=readHtmlCollection('minutes/2026').filter(p=>isVisible(p.status,import.meta.env.PROD)&&p.slug!=='cybernetics');
---
<Base title="OneWater Minute" active="/minute/" description="One idea, one minute. A short read that changes how you see the bigger picture."><section class="page-head"><p class="kicker">OneWater Minute</p><h1>Small idea.<br/><em>Bigger picture.</em></h1><p class="lede">A single concept, made plain, in the time it takes to read it. One minute to see the system differently.</p></section><ul class="post-list"><li class="post-row"><a href="/minute/cybernetics/"><span class="post-meta">01 / SYSTEMS &amp; CONTROL · 1 MIN READ</span><h2 class="post-title">A reading is only the beginning. ↗</h2><p class="post-desc">A sensor gives you a reading. A feedback loop helps you decide what to do next.</p></a></li>{items.map(it=><li class="post-row"><a href={`/minute/${it.slug}.html`}><h2 class="post-title">{it.title} ↗</h2></a></li>)}</ul></Base>
